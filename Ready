/**
 * Ready.gs — 운영평가 사전 점검 체크리스트
 *
 * 업무분장 → 서비스 → 시스템 → 인프라 → 점검 확정 순으로 진행한다.
 * 각 단계에서 평가대상기간에 발생한 신규·폐기를 마스터에서 자동으로 긁어오고,
 * 담당자가 확인 코멘트를 남기면 T_변동점검에 기록된다.
 *
 * 정보 수정은 마스터에 이력이 없어 자동 감지되지 않는다. 직접 추가로 등록한다.
 */

var PRE_STEPS = [
  { key: 'duty', no: 1, title: '업무분장', target: '업무분장' },
  { key: 'svc', no: 2, title: '서비스', target: '서비스' },
  { key: 'sys', no: 3, title: '시스템', target: '시스템' },
  { key: 'inf', no: 4, title: '인프라', target: '인프라' },
  { key: 'fin', no: 5, title: '점검 확정', target: '' }
];

function _inRange(d, st, en) {
  var v = String(d || '').substring(0, 10);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(v)) return false;
  return v >= st && v <= en;
}

/** 자동 추출 항목의 고정 점검ID. 같은 항목은 항상 같은 ID를 갖는다 */
function _preId(period, id, kind) {
  return 'CHK-' + period + '-' + String(id).replace(/[^\w-]/g, '') + '-' +
         (kind === '신규' ? 'S' : (kind === '폐기' ? 'E' : 'M'));
}

/** 마스터에서 평가대상기간 내 신규·폐기를 긁어온다 */
function _autoItems(target, st, en, period) {
  var out = [];
  function push(kind, id, name, date, belong, note) {
    out.push({
      chkId: _preId(period, id, kind), target: target, kind: kind,
      refId: id, name: name, date: String(date).substring(0, 10),
      belong: belong || '', note: note || '', auto: true
    });
  }
  if (target === '서비스') {
    getRows('M_서비스').forEach(function (r) {
      if (_inRange(r['적용시작일'], st, en))
        push('신규', r['서비스ID'], r['서비스명'], r['적용시작일'], r['사업부문']);
      if (_inRange(r['적용종료일'], st, en))
        push('폐기', r['서비스ID'], r['서비스명'], r['적용종료일'], r['사업부문']);
    });
  } else if (target === '시스템') {
    getRows('M_시스템').forEach(function (r) {
      if (_inRange(r['적용시작일'], st, en))
        push('신규', r['시스템ID'], r['시스템명'], r['적용시작일'], r['시스템군']);
      if (_inRange(r['적용종료일'], st, en))
        push('폐기', r['시스템ID'], r['시스템명'], r['적용종료일'], r['시스템군']);
    });
  } else if (target === '인프라') {
    getRows('M_인프라').forEach(function (r) {
      var belong = String(r['시스템ID'] || '') + ' · ' + String(r['자산구분'] || '');
      if (_inRange(r['적용시작일'], st, en))
        push('신규', r['인프라ID'], r['호스트명'], r['적용시작일'], belong);
      if (_inRange(r['적용종료일'], st, en))
        push('폐기', r['인프라ID'], r['호스트명'], r['적용종료일'], belong);
    });
    /* 어느 평가단위도 참조하지 않는 DB·장비 */
    var used = {};
    getRows('T_평가단위').forEach(function (r) {
      splitIds(r['인프라ID']).forEach(function (i) { used[i] = 1; });
    });
    getRows('M_인프라').forEach(function (r) {
      if (String(r['상태']) !== '사용') return;
      var k = String(r['자산구분']);
      if (k !== 'DB' && k !== 'Network') return;
      if (used[String(r['인프라ID'])]) return;
      out.push({
        chkId: _preId(period, r['인프라ID'], '미참조'), target: '인프라', kind: '미참조',
        refId: r['인프라ID'], name: r['호스트명'], date: '',
        belong: String(r['시스템ID'] || '') + ' · ' + k,
        note: '평가단위가 참조하지 않습니다', auto: true
      });
    });
  }
  return out;
}

/** 사전 점검 전체 */
function getPrecheck() {
  try {
    var period = cfg('CURRENT_PERIOD');
    var st = String(cfg('PERIOD_START')).substring(0, 10);
    var en = String(cfg('PERIOD_END')).substring(0, 10);

    var logged = {};
    getRows('T_변동점검').forEach(function (r) {
      if (String(r['비고'] || '').indexOf('예시행') >= 0) return;
      logged[String(r['점검ID'])] = {
        chkId: r['점검ID'], target: r['점검대상'], item: r['점검항목'],
        src: r['자료출처부서'], got: String(r['자료수령일']).substring(0, 10),
        nNew: r['변동_신규'] || 0, nMod: r['변동_수정'] || 0, nDel: r['변동_삭제'] || 0,
        summary: r['변동요약'], itgc: r['ITGC영향여부'],
        euIds: r['영향받는_평가단위'] || '', ctrls: r['영향받는_통제코드'] || '',
        applied: r['마스터반영여부'], action: r['후속조치'] || '',
        byId: r['점검자ID'], at: String(r['점검일자']).substring(0, 10),
        done: r['완료여부'], note: r['비고'] || '', row: r._row
      };
    });

    var steps = [];
    PRE_STEPS.forEach(function (sp) {
      var o = { key: sp.key, no: sp.no, title: sp.title, target: sp.target };

      if (sp.key === 'duty') {
        var dm = getDutyMatrix(null);
        var rv = getRows('T_분장검토').filter(function (r) {
          return String(r['평가기수']) === period;
        }).sort(function (a, b) { return String(b['검토일시']) < String(a['검토일시']) ? -1 : 1; });
        var last = rv[0];
        o.duty = {
          base: dm.ok ? dm.base : '', counts: dm.ok ? dm.counts : null,
          reviewed: !!last,
          lastAt: last ? String(last['검토일시']).substring(0, 16) : '',
          lastBy: last ? last['검토자명'] : '',
          concl: last ? last['결론'] : '', opinion: last ? last['검토의견'] : ''
        };
        o.items = [];
        o.state = !last ? 'todo' : (last['결론'] === '적정' ? 'ok' : 'warn');
        o.summary = !last ? '이번 기수 검토 기록이 없습니다'
          : (o.duty.lastAt + ' · ' + o.duty.lastBy + ' · ' + o.duty.concl +
             ' · 겸직 ' + (dm.ok ? dm.counts.viol : 0) + '건(미승인 ' +
             (dm.ok ? dm.counts.unapproved : 0) + ')');
      } else if (sp.key === 'fin') {
        o.items = [];
        o.state = 'ok';
        o.summary = '';
      } else {
        var auto = _autoItems(sp.target, st, en, period);
        var seen = {};
        auto.forEach(function (x) {
          seen[x.chkId] = 1;
          var lg = logged[x.chkId];
          x.logged = !!lg;
          if (lg) {
            x.summary = lg.summary; x.itgc = lg.itgc; x.applied = lg.applied;
            x.action = lg.action; x.done = lg.done; x.at = lg.at;
            x.euIds = lg.euIds; x.ctrls = lg.ctrls;
          }
        });
        /* 직접 추가한 건 */
        Object.keys(logged).forEach(function (k) {
          var lg = logged[k];
          if (String(lg.target) !== sp.target || seen[k]) return;
          auto.push({
            chkId: lg.chkId, target: lg.target, kind: '수정', refId: '', name: lg.item,
            date: lg.at, belong: lg.src || '', note: '', auto: false, logged: true,
            summary: lg.summary, itgc: lg.itgc, applied: lg.applied,
            action: lg.action, done: lg.done, at: lg.at, euIds: lg.euIds, ctrls: lg.ctrls
          });
        });
        o.items = auto;
        var un = auto.filter(function (x) { return !x.logged; }).length;
        var pend = auto.filter(function (x) {
          return x.logged && (x.applied === '반영대기' || x.done === '진행중'); }).length;
        o.state = !auto.length ? 'ok' : (un ? 'todo' : (pend ? 'warn' : 'ok'));
        o.summary = !auto.length ? '평가대상기간에 감지된 변동이 없습니다'
          : (auto.length + '건 · 미기록 ' + un + '건 · 반영대기·진행중 ' + pend + '건');
      }
      steps.push(o);
    });

    /* 요약 */
    var all = [];
    steps.forEach(function (s) { if (s.items) all = all.concat(s.items); });
    var sum = {
      total: all.length,
      logged: all.filter(function (x) { return x.logged; }).length,
      unlogged: all.filter(function (x) { return !x.logged; }).length,
      itgc: all.filter(function (x) { return x.itgc === 'Y'; }).length,
      pending: all.filter(function (x) { return x.applied === '반영대기'; }).length,
      byKind: {}, byTarget: {}
    };
    all.forEach(function (x) {
      sum.byKind[x.kind] = (sum.byKind[x.kind] || 0) + 1;
      sum.byTarget[x.target] = (sum.byTarget[x.target] || 0) + 1;
    });
    var ready = steps.every(function (s) { return s.state === 'ok'; });

    /* 사이클 진행 안내 — 관리자가 무엇을 언제 해야 하는지 */
    var confirmed = getRows('T_변동점검').some(function (x) {
      return String(x['점검기수']) === period && String(x['비고']) === '사전 점검 확정 기록';
    });
    var euAll = getRows('T_평가단위').filter(function (x) { return String(x['상태']) !== '삭제'; });
    var evByEu = {}, noOwner = 0;
    getRows('T_증빙정의').forEach(function (d) {
      if (String(d['상태']) !== '사용') return;
      evByEu[String(d['평가단위ID'])] = 1;
      if (!d['담당자ID']) noOwner++;
    });
    var undef = euAll.filter(function (x) { return !evByEu[String(x['평가단위ID'])]; }).length;
    var mailed = getRows('T_메일발송').filter(function (x) {
      return String(x['평가기수']) === period && String(x['발송유형']) === '최초요청' &&
             (x['상태'] === '발송완료' || x['상태'] === '미발송(테스트)');
    }).length;
    var dutyOk = steps[0].duty && steps[0].duty.reviewed;

    var guide = [
      { no: 1, title: '변동 확인·기록', where: '이 화면 2~4단계',
        done: sum.unlogged === 0 && sum.total >= 0,
        desc: '서비스·시스템·인프라에서 감지된 변동을 확인하고 변동요약을 기록합니다',
        stat: sum.unlogged ? '미기록 ' + sum.unlogged + '건' : '기록 완료' },
      { no: 2, title: '마스터 반영', where: 'M_서비스 · M_시스템 · M_인프라 시트',
        done: sum.pending === 0,
        desc: '변동을 마스터에 반영하고 기록의 마스터반영여부를 반영완료로 바꿉니다',
        stat: sum.pending ? '반영대기 ' + sum.pending + '건' : '반영 완료' },
      { no: 3, title: '업무분장 검토', where: '업무분장 검토 메뉴',
        done: !!dutyOk,
        desc: '새 기준일 업무분장표를 M_업무분장에 반영하고 분리원칙을 검토합니다',
        stat: dutyOk ? '검토 완료' : '미검토' },
      { no: 4, title: '점검 확정', where: '이 화면 5단계',
        done: confirmed,
        desc: '변동 기록을 모두 마친 뒤 확정합니다. 확정 기록이 감사 근거가 됩니다',
        stat: confirmed ? '확정됨' : '미확정' },
      { no: 5, title: '기수 전환', where: '사이드바 [기수 전환]',
        done: false, manual: true,
        desc: '반드시 4단계 확정 뒤에 하십시오. 먼저 바꾸면 이전 기수 변동을 볼 수 없습니다. ' +
              '설정 6개(기수·기간·전기·마감일·잠금)가 자동으로 갱신됩니다',
        stat: '새 사이클 시작 시' },
      { no: 6, title: '평가단위·증빙정의 검토', where: '평가단위 · 증빙정의 메뉴',
        done: undef === 0 && noOwner === 0,
        desc: '변동에 맞춰 평가단위를 조정하고 증빙정의와 담당자를 채웁니다',
        stat: (undef ? '증빙 미정의 ' + undef + '개 평가단위' : '') +
              (undef && noOwner ? ' · ' : '') +
              (noOwner ? '담당자 미지정 ' + noOwner + '건' : '') ||
              '정의 완료' },
      { no: 7, title: '증빙 요청 메일 발송', where: '담당자 요청메일 발송 메뉴',
        done: mailed > 0,
        desc: '최초 요청을 보내고, 이후 미제출자에게 독촉을 보냅니다',
        stat: mailed ? '발송 ' + mailed + '건' : '미발송' }
    ];
    var guideNote = [
      'C_코드의 평가기수 그룹에 다음 기수를 미리 등록해 두셔야 기수 전환 드롭다운에 나옵니다.',
      '증빙정의의 조회기간구분을 비워 두면 평가기간을 따라가므로 기수마다 고치실 필요가 없습니다.',
      '예시 자료(예시파일URL)를 직전 기수 증빙으로 바꿔 두면 담당자가 더 정확하게 제출합니다.',
      'M_서비스·M_시스템·M_인프라·M_사용자는 변동이 있을 때만 손대시면 됩니다.'
    ];

    return {
      ok: true, period: period, label: _periodLabel(period), start: st, end: en,
      steps: steps, summary: sum, ready: ready,
      guide: guide, guideNote: guideNote,
      depts: _uniq(getRows('T_평가단위').map(function (r) { return r['수행부서']; }))
    };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

/** 점검 항목 기록 · 수정 */
function savePrecheckItem(p) {
  try {
    assertUnlocked();
    var me = currentUser();
    if (!me || (me['역할'] !== '관리자' && me['역할'] !== '검토자')) {
      throw new Error('관리자 또는 검토자만 기록할 수 있습니다');
    }
    if (!String(p.summary || '').trim()) throw new Error('변동요약을 입력하십시오');
    var period = cfg('CURRENT_PERIOD');
    var chkId = String(p.chkId || '').trim() ||
      ('CHK-' + period + '-M' + new Date().getTime().toString(36).toUpperCase());

    var body = {
      '점검ID': chkId, '점검기수': period, '점검대상': p.target,
      '점검항목': p.item, '자료출처부서': p.src || '',
      '자료요청일': p.reqDate || '', '자료수령일': p.gotDate || '',
      '근거파일ID': '', '근거파일명': '',
      '변동_신규': Number(p.nNew || 0), '변동_수정': Number(p.nMod || 0),
      '변동_삭제': Number(p.nDel || 0),
      '변동요약': String(p.summary).trim(),
      'ITGC영향여부': p.itgc || 'N',
      '영향받는_평가단위': p.euIds || '', '영향받는_통제코드': p.ctrls || '',
      '마스터반영여부': p.applied || '반영대기',
      '마스터반영일': p.applied === '반영완료' ? (p.appliedAt || now_().substring(0, 10)) : '',
      '후속조치': p.action || '', '후속조치완료일': '',
      '점검자ID': me['사용자ID'], '점검일자': p.chkDate || now_().substring(0, 10),
      '완료여부': p.done || '진행중', '비고': p.note || ''
    };

    var ex = findRow('T_변동점검', '점검ID', chkId);
    if (ex) {
      Object.keys(body).forEach(function (k) {
        if (k === '점검ID') return;
        try { updateCell('T_변동점검', ex._row, k, body[k]); } catch (e) { }
      });
    } else {
      withLock(function () { appendRow('T_변동점검', body); });
    }
    return { ok: true, chkId: chkId, updated: !!ex };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

/** 점검 확정 — 진행중 항목을 완료로 바꾸고 업무분장 검토까지 함께 확인 */
function confirmPrecheck(opinion) {
  try {
    assertUnlocked();
    var me = currentUser();
    if (!me || me['역할'] !== '관리자') throw new Error('관리자만 확정할 수 있습니다');
    var pre = getPrecheck();
    if (!pre.ok) throw new Error(pre.error);
    if (pre.summary.unlogged > 0) {
      throw new Error('기록되지 않은 변동이 ' + pre.summary.unlogged + '건 있습니다. 먼저 기록하십시오.');
    }
    var period = cfg('CURRENT_PERIOD');
    var n = 0;
    getRows('T_변동점검').forEach(function (r) {
      if (String(r['점검기수']) !== period) return;
      if (String(r['완료여부']) === '완료') return;
      updateCell('T_변동점검', r._row, '완료여부', '완료');
      n++;
    });
    withLock(function () {
      appendRow('T_변동점검', {
        '점검ID': 'CHK-' + period + '-CONFIRM-' + now_().replace(/[^0-9]/g, '').substring(0, 12),
        '점검기수': period, '점검대상': '서비스', '점검항목': '사전 점검 확정',
        '자료출처부서': '리스크관리팀', '자료수령일': now_().substring(0, 10),
        '변동_신규': pre.summary.byKind['신규'] || 0,
        '변동_수정': pre.summary.byKind['수정'] || 0,
        '변동_삭제': pre.summary.byKind['폐기'] || 0,
        '변동요약': String(opinion || '').trim() ||
          ('사전 점검 완료. 총 ' + pre.summary.total + '건 확인, ITGC 영향 ' + pre.summary.itgc + '건'),
        'ITGC영향여부': pre.summary.itgc > 0 ? 'Y' : 'N',
        '마스터반영여부': pre.summary.pending > 0 ? '반영대기' : '반영완료',
        '마스터반영일': pre.summary.pending > 0 ? '' : now_().substring(0, 10),
        '점검자ID': me['사용자ID'], '점검일자': now_().substring(0, 10),
        '완료여부': '완료', '비고': '사전 점검 확정 기록'
      });
    });
    return { ok: true, closed: n, total: pre.summary.total, itgc: pre.summary.itgc };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

/* ─────────────── 엑셀 ─────────────── */

function exportPrecheck() {
  var tempId = null;
  try {
    var r = getPrecheck();
    if (!r.ok) throw new Error(r.error);
    var name = '운영평가_사전점검_' + r.period + '_' + now_().substring(0, 10);
    var temp = SpreadsheetApp.create(name);
    tempId = temp.getId();

    /* 1. 요약 */
    var sh = temp.getSheets()[0];
    sh.setName('사전점검 요약');
    var STN = { ok: '이상 없음', warn: '확인 필요', todo: '미기록' };
    var g = [[name],
             [r.label + ' · 평가대상기간 ' + r.start + ' ~ ' + r.end + ' · 생성 ' + now_()], [],
             ['단계', '구분', '상태', '요약']];
    r.steps.forEach(function (s) { g.push([s.no, s.title, STN[s.state] || '', s.summary || '']); });
    g.push([]);
    g.push(['총 변동', r.summary.total + '건', '',
            '신규 ' + (r.summary.byKind['신규'] || 0) +
            ' · 폐기 ' + (r.summary.byKind['폐기'] || 0) +
            ' · 수정 ' + (r.summary.byKind['수정'] || 0) +
            ' · 미참조 ' + (r.summary.byKind['미참조'] || 0)]);
    g.push(['기록 상태', '기록 ' + r.summary.logged + ' / 미기록 ' + r.summary.unlogged, '', '']);
    g.push(['ITGC 영향', r.summary.itgc + '건', '', '마스터 반영대기 ' + r.summary.pending + '건']);
    g.push(['종합', r.ready ? '착수 가능' : '조치 후 착수', '', '']);
    sh.getRange(1, 1, g.length, 4).setValues(
      g.map(function (x) { var o = x.slice(); while (o.length < 4) o.push(''); return o; }));
    sh.getRange(1, 1).setFontWeight('bold').setFontSize(13);
    sh.getRange(4, 1, 1, 4).setFontWeight('bold').setBackground('#DCE6F0');
    sh.setColumnWidth(1, 60); sh.setColumnWidth(2, 150);
    sh.setColumnWidth(3, 100); sh.setColumnWidth(4, 560);

    /* 2. 변동 상세 */
    var s2 = temp.insertSheet('변동 상세');
    var h2 = ['구분', '변동유형', '대상ID', '명칭', '일자', '소속', '기록여부',
              '변동요약', 'ITGC영향', '영향 평가단위', '영향 통제', '마스터반영',
              '후속조치', '완료여부', '점검일자'];
    var g2 = [['평가대상기간 내 변동 상세'],
              ['자동 감지 ' + r.summary.total + '건 · 기록 ' + r.summary.logged +
               '건 · 미기록 ' + r.summary.unlogged + '건'], h2];
    r.steps.forEach(function (s) {
      (s.items || []).forEach(function (x) {
        g2.push([x.target, x.kind, x.refId, x.name, x.date, x.belong,
                 x.logged ? '기록됨' : '미기록', x.summary || '', x.itgc || '',
                 x.euIds || '', x.ctrls || '', x.applied || '',
                 x.action || '', x.done || '', x.at || '']);
      });
    });
    if (g2.length === 3) g2.push(['', '감지된 변동이 없습니다']);
    s2.getRange(1, 1, g2.length, h2.length).setValues(
      g2.map(function (x) { var o = x.slice(); while (o.length < h2.length) o.push(''); return o; }));
    s2.getRange(1, 1).setFontWeight('bold').setFontSize(12);
    s2.getRange(3, 1, 1, h2.length).setFontWeight('bold').setBackground('#DCE6F0');
    s2.setFrozenRows(3);

    /* 3. 업무분장 */
    var d = r.steps[0].duty || {};
    var s3 = temp.insertSheet('업무분장 검토');
    var g3 = [['개발·운영 분리원칙 검토'],
              ['기준일 ' + (d.base || '-')], [],
              ['검토 여부', d.reviewed ? '검토 완료' : '미검토'],
              ['검토일시', d.lastAt || '-'],
              ['검토자', d.lastBy || '-'],
              ['결론', d.concl || '-'],
              ['검토의견', d.opinion || '-'], []];
    if (d.counts) {
      g3.push(['담당자 행', d.counts.total]);
      g3.push(['겸직 탐지', d.counts.viol]);
      g3.push(['예외 승인', d.counts.approved]);
      g3.push(['조치 필요', d.counts.unapproved]);
    }
    s3.getRange(1, 1, g3.length, 2).setValues(
      g3.map(function (x) { var o = x.slice(); while (o.length < 2) o.push(''); return o; }));
    s3.getRange(1, 1).setFontWeight('bold').setFontSize(12);
    s3.setColumnWidth(1, 140); s3.setColumnWidth(2, 520);

    /* 4. 변동점검 원장 */
    var s4 = temp.insertSheet('변동점검 원장');
    var h4 = ['점검ID', '점검기수', '점검대상', '점검항목', '자료출처부서', '자료수령일',
              '신규', '수정', '삭제', '변동요약', 'ITGC영향', '영향 평가단위', '영향 통제',
              '마스터반영', '마스터반영일', '후속조치', '점검자', '점검일자', '완료여부', '비고'];
    var users = {};
    getRows('M_사용자').forEach(function (u) { users[u['사용자ID']] = u['성명']; });
    var g4 = [h4];
    getRows('T_변동점검').forEach(function (x) {
      if (String(x['점검기수']) !== r.period) return;
      g4.push([x['점검ID'], x['점검기수'], x['점검대상'], x['점검항목'], x['자료출처부서'],
               String(x['자료수령일']).substring(0, 10),
               x['변동_신규'], x['변동_수정'], x['변동_삭제'], x['변동요약'],
               x['ITGC영향여부'], x['영향받는_평가단위'], x['영향받는_통제코드'],
               x['마스터반영여부'], String(x['마스터반영일']).substring(0, 10),
               x['후속조치'], users[x['점검자ID']] || x['점검자ID'],
               String(x['점검일자']).substring(0, 10), x['완료여부'], x['비고']]);
    });
    s4.getRange(1, 1, g4.length, h4.length).setValues(g4);
    s4.getRange(1, 1, 1, h4.length).setFontWeight('bold').setBackground('#DCE6F0');
    s4.setFrozenRows(1);

    SpreadsheetApp.flush();
    var blob = UrlFetchApp.fetch(
      'https://docs.google.com/spreadsheets/d/' + tempId + '/export?format=xlsx',
      { headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() } }
    ).getBlob().setName(name + '.xlsx');

    var folder = ensureFolderPath(cfg('FOLDER_CHANGE'), [r.period]);
    var it = folder.getFilesByName(name + '.xlsx');
    while (it.hasNext()) it.next().setTrashed(true);
    var file = folder.createFile(blob);
    return { ok: true, name: file.getName(), url: file.getUrl(), size: file.getSize() };
  } catch (e) {
    return { ok: false, error: e.message };
  } finally {
    if (tempId) { try { DriveApp.getFileById(tempId).setTrashed(true); } catch (e) { } }
  }
}
