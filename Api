}

/* ─────────────── 기수 잠금 ─────────────── */

/** 잠긴 기수에서 데이터를 바꾸려 할 때 막는다. 서버에서 한 번 더 확인한다 */
function assertUnlocked() {
  if (String(cfgOpt('PERIOD_LOCKED', 'N')).toUpperCase() === 'Y') {
    throw new Error('현 기수는 운영평가 완료로 잠겨 있습니다. 관리자가 잠금을 해제해야 수정할 수 있습니다.');
  }
}

function getLockInfo() {
  try {
    var locked = String(cfgOpt('PERIOD_LOCKED', 'N')).toUpperCase() === 'Y';
    var byId = cfgOpt('PERIOD_LOCKED_BY');
    var u = byId ? findRow('M_사용자', '사용자ID', byId) : null;
    var hist = getRows('T_기수잠금').map(function (r) {
      return {
        id: r['잠금ID'], period: r['평가기수'], act: r['작업구분'],
        at: r['작업일시'], byId: r['작업자ID'], by: r['작업자명'],
        reason: r['사유'], files: r['증빙파일건수'],
        pops: r['모집단건수'], wps: r['조서건수']
      };
    }).sort(function (a, b) { return String(b.at) < String(a.at) ? -1 : 1; });
    return {
      ok: true, locked: locked, period: cfg('CURRENT_PERIOD'),
      at: cfgOpt('PERIOD_LOCKED_AT'), byId: byId,
      by: u ? u['성명'] : byId, history: hist
    };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

/**
 * 기수 잠금 / 해제
 * @param {string} action 잠금 | 해제
 * @param {string} reason 해제 시 필수
 */
function setPeriodLock(action, reason) {
  try {
    var me = currentUser();
    if (!me || me['역할'] !== '관리자') {
      throw new Error('관리자만 잠금을 변경할 수 있습니다');
    }
    var cur = String(cfgOpt('PERIOD_LOCKED', 'N')).toUpperCase() === 'Y';
    if (action === '잠금' && cur) throw new Error('이미 잠겨 있습니다');
    if (action === '해제' && !cur) throw new Error('잠겨 있지 않습니다');
    if (action === '해제' && !String(reason || '').trim()) {
      throw new Error('해제 사유를 입력하십시오');
    }

    var period = cfg('CURRENT_PERIOD');
    var nFiles = getRows('T_증빙파일').filter(function (f) {
      return String(f['평가기수']) === period && f['상태'] !== '삭제';
    }).length;
    var nPop = 0, nWp = 0;
    try {
      nPop = getRows('T_모집단').filter(function (r) {
        return String(r['평가기수']) === period; }).length;
    } catch (e) { }
    try {
      nWp = getRows('T_평가조서').filter(function (r) {
        return String(r['평가기수']) === period; }).length;
    } catch (e) { }

    withLock(function () {
      appendRow('T_기수잠금', {
        '잠금ID': nextId('T_기수잠금', '잠금ID', 'LK-', 6),
        '평가기수': period, '작업구분': action, '작업일시': now_(),
        '작업자ID': me['사용자ID'], '작업자명': me['성명'],
        '사유': String(reason || '').trim(),
        '증빙파일건수': nFiles, '모집단건수': nPop, '조서건수': nWp, '비고': ''
      });
    });

    _setConfig('PERIOD_LOCKED', action === '잠금' ? 'Y' : 'N');
    _setConfig('PERIOD_LOCKED_AT', action === '잠금' ? now_() : '');
    _setConfig('PERIOD_LOCKED_BY', action === '잠금' ? me['사용자ID'] : '');
    try { _configCache = null; } catch (e) { }
    delete _memo['C_설정'];

    return { ok: true, action: action, locked: action === '잠금',
             period: period, at: now_(), by: me['성명'], files: nFiles };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

/* ─────────────── 평가기수 전환 ─────────────── */

function _setConfig(key, value) {
  var r = findRow('C_설정', '설정키', key);
  if (!r) throw new Error('설정키를 찾을 수 없습니다: ' + key);
  updateCell('C_설정', r._row, '설정값', value);
  try {
    updateCell('C_설정', r._row, '최종수정일시', now_());
    var me = currentUser();
    updateCell('C_설정', r._row, '수정자ID', me ? me['사용자ID'] : currentEmail());
  } catch (e) { }
}

/** 전환 전 현재 설정을 돌려준다 */
function previewPeriod(period) {
  try {
    var names = {};
    getCodes('평가기수').forEach(function (c) { names[c.value] = c.label; });
    return {
      ok: true, period: period, label: names[period] || period,
      curPeriod: cfg('CURRENT_PERIOD'), curStart: cfg('PERIOD_START'),
      curEnd: cfg('PERIOD_END'), curPrev: cfg('PREV_PERIOD'),
      curDue: cfg('EVIDENCE_DUE_DATE')
    };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

function _isDate(v) { return /^\d{4}-\d{2}-\d{2}$/.test(String(v || '')); }

/**
 * 진행 기수를 전환한다. 모든 사용자에게 적용된다.
 * 기간은 자동 계산하지 않고 입력받는다. 반기·분기·임의 구간을 모두 쓸 수 있어야 하기 때문이다.
 * @param {Object} p {period, start, end, prev, due}
 */
function switchPeriod(p) {
  try {
    var me = currentUser();
    if (!me || me['역할'] !== '관리자') throw new Error('관리자만 기수를 전환할 수 있습니다');
    if (!p || !String(p.period).trim()) throw new Error('기수를 선택하십시오');
    if (!_isDate(p.start) || !_isDate(p.end)) {
      throw new Error('평가대상기간을 yyyy-MM-dd 형식으로 입력하십시오');
    }
    if (String(p.start) > String(p.end)) throw new Error('시작일이 종료일보다 늦습니다');
    if (!_isDate(p.due)) throw new Error('증빙 제출 마감일을 yyyy-MM-dd 형식으로 입력하십시오');
    if (!String(p.prev).trim()) throw new Error('전기 기수를 선택하십시오');
    if (String(p.prev) === String(p.period)) throw new Error('전기 기수가 현재 기수와 같습니다');

    var before = cfg('CURRENT_PERIOD');
    _setConfig('CURRENT_PERIOD', String(p.period).trim());
    _setConfig('PERIOD_START', p.start);
    _setConfig('PERIOD_END', p.end);
    _setConfig('PREV_PERIOD', String(p.prev).trim());
    _setConfig('EVIDENCE_DUE_DATE', p.due);
    /* 새 기수는 잠금 없이 시작한다 */
    _setConfig('PERIOD_LOCKED', 'N');
    _setConfig('PERIOD_LOCKED_AT', '');
    _setConfig('PERIOD_LOCKED_BY', '');

    try { _configCache = null; } catch (e) { }
    delete _memo['C_설정'];

    return { ok: true, before: before, period: p.period,
             start: p.start, end: p.end, prev: p.prev, due: p.due };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

function _idSet(rows, key) {
  var s = {};
  rows.forEach(function (r) { if (r[key]) s[String(r[key]).trim()] = 1; });
  return s;
}
