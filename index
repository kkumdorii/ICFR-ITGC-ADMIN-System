        var cls=p.dup?(p.exc?'pn exc':'pn dup'):'pn';
        h+='<span class="'+cls+'">'+(p.part?'<span class="pt">('+esc(p.part)+')</span> ':'')+
           esc(p.name)+(p.rank?' '+esc(p.rank):'')+
           (p.dup?(p.exc?' 예외':' 겸직'):'')+'</span>';
      });
      h+='</td>';
    });
    h+=dtCheckCell(s.check);
    h+='</tr>';
  });
  h+='</tbody></table></div>';

