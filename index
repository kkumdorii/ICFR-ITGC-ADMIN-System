<!DOCTYPE html>
<html>
<head>
<base target="_top">
<meta charset="utf-8">
<style>
  /* 사내망에서 외부 CDN이 차단될 수 있어 모든 스타일·스크립트를 내장한다 */
  :root{
    /* 전사 PPT 템플릿 색상 (theme accent1~5) */
    --brand:#2482C8;   /* accent1 — 전사 대표색 */
    --brand-d:#1768CB; /* accent2 */
    --brand3:#2F5597;  /* accent3 */
    --brand2:#203864;  /* accent4 — 딥네이비 */
    --slate:#5A6E78;   /* accent5 */
    --ink:#2B323D; --mut:#5A6E78;
    --line:#DCE6F0; --bg:#F3F7FB; --card:#fff;
    --ok:#1E7E68; --warn:#B8860B; --err:#C0392B;
    --sh:0 2px 10px rgba(32,56,100,.07); --sh2:0 6px 24px rgba(32,56,100,.13);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'맑은 고딕','Malgun Gothic',sans-serif;background:var(--bg);
       color:var(--ink);font-size:13px;-webkit-font-smoothing:antialiased}
  .wrap{display:flex;min-height:100vh}

  /* 사이드바 — 채도를 낮춘 스틸 블루. 선택된 메뉴만 흰색으로 뜬다 */
  .side{width:232px;background:linear-gradient(180deg,#5183BC 0%,#4E7FB8 45%,#456FA3 100%);
        flex-shrink:0;padding:24px 0;box-shadow:2px 0 12px rgba(45,66,96,.13);position:relative;z-index:2}
  .side h1{font-size:14.5px;padding:0 20px 5px;line-height:1.45;color:#fff;font-weight:bold;
           letter-spacing:-.2px}
  .side .sub{font-size:11.5px;color:rgba(255,255,255,.76);padding:0 20px 4px}
  .pdsw{margin:0 20px 20px;font-size:11px;color:rgba(255,255,255,.72);cursor:pointer;
        border:1px solid rgba(255,255,255,.35);border-radius:6px;padding:4px 9px;
        display:inline-block;transition:.15s}
  .pdsw:hover{background:rgba(255,255,255,.16);color:#fff}
  .lockbar{background:#F6EEF6;border:1px solid #D9C2D9;border-left:4px solid #7B4B7B;
           border-radius:10px;padding:13px 17px;margin-bottom:14px;font-size:12.5px;
           color:#5C3A5C;line-height:1.8;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
  .lockbar b{color:#432843}
  .lockbar .sp{margin-left:auto}
  .mtx{border-collapse:collapse;font-size:11.5px;background:#fff;width:100%}
  .mtx th{background:#EDF4FB;color:#203864;padding:8px 9px;border:1px solid var(--line);
          text-align:center;white-space:nowrap;position:sticky;top:0;z-index:2}
  .mtx td{padding:7px 9px;border:1px solid #EEF3F8;vertical-align:top;line-height:1.7}
  .mtx td.sysn{font-weight:bold;color:var(--brand2);white-space:nowrap;background:#FAFCFE;
               position:sticky;left:0;z-index:1}
  .mtx .tm{font-size:11.5px;color:var(--brand2);font-weight:bold;display:block;
           padding-bottom:5px;margin-bottom:6px;border-bottom:1px solid #E4ECF4}
  .mtx .pn{display:block;white-space:nowrap;padding-left:11px;position:relative;color:#3E4E64}
  .mtx .pn:before{content:'';position:absolute;left:1px;top:8px;width:4px;height:4px;
                  border-radius:50%;background:#AFBDC9}
  .mtx .pn.dup{color:var(--err);font-weight:bold}
  .mtx .pn.dup:before{background:var(--err)}
  .mtx .pn.exc{color:#B8860B;font-weight:bold}
  .mtx .pn.exc:before{background:#B8860B}
  .mtx .pt{font-size:10px;color:var(--mut)}
  .mtx .tm+.tm{margin-top:-2px}
  .gd{background:#fff;border:1px solid var(--line);border-radius:12px;margin:16px 0 18px;
      box-shadow:var(--sh);overflow:hidden}
  .gd .gdh{display:flex;align-items:center;gap:10px;padding:14px 18px;cursor:pointer;
           user-select:none;font-size:14px;font-weight:bold;color:var(--brand2)}
  .gd .gdh:hover{background:#F7FBFE}
  .gd .gdh .ar{font-size:10px;color:var(--mut);transition:transform .18s}
  .gd.cl .gdh .ar{transform:rotate(-90deg)}
  .gd .gdh .cnt2{margin-left:auto;font-size:12px;font-weight:normal;color:var(--mut)}
  .gd .gdb{border-top:1px solid #EEF3F8;padding:6px 18px 16px}
  .gd.cl .gdb{display:none}
  .gdr{display:flex;gap:13px;align-items:flex-start;padding:11px 0;border-bottom:1px solid #F4F7FA}
  .gdr:last-child{border-bottom:none}
  .gdr .n{width:25px;height:25px;border-radius:50%;flex-shrink:0;display:flex;
          align-items:center;justify-content:center;font-size:11.5px;font-weight:bold;
          background:#EEF1F4;color:#5A6E78;margin-top:1px}
  .gdr.done .n{background:#E4F3E8;color:#1E7E68}
  .gdr.man .n{background:#EDF4FB;color:#2F5597}
  .gdr .bd{flex:1;min-width:0}
  .gdr .t1{font-size:13.5px;font-weight:bold;color:var(--brand2)}
  .gdr .t1 .wh{font-size:11.5px;font-weight:normal;color:var(--brand);margin-left:8px}
  .gdr .d1{font-size:12px;color:var(--mut);line-height:1.75;margin-top:2px}
  .gdr .s1{margin-left:auto;font-size:11.5px;font-weight:bold;border-radius:20px;
           padding:4px 11px;white-space:nowrap;flex-shrink:0}
  .gdr .s1.y{background:#E4F3E8;color:#1E7E68}
  .gdr .s1.n{background:#FCF2DC;color:#B8860B}
  .gdr .s1.m{background:#EDF4FB;color:#2F5597}
  .gdnote{background:#F3F7FB;border-radius:9px;padding:12px 15px;margin-top:12px;
          font-size:11.5px;color:var(--mut);line-height:1.9}
  .steps{display:flex;align-items:stretch;gap:4px;margin:16px 0 18px;flex-wrap:wrap}
  .stp{flex:1;min-width:150px;background:#fff;border:1px solid var(--line);border-radius:10px;
       padding:12px 14px;cursor:pointer;display:flex;gap:10px;align-items:flex-start;
       transition:.15s;box-shadow:var(--sh)}
  .stp:hover{background:#F7FBFE}
  .stp .sn{width:24px;height:24px;border-radius:50%;flex-shrink:0;display:flex;
           align-items:center;justify-content:center;font-size:12px;font-weight:bold;
           background:#EDF1F4;color:#5A6E78}
  .stp .sl{display:flex;flex-direction:column;line-height:1.5;min-width:0}
  .stp .sl b{font-size:13px;color:var(--brand2)}
  .stp .sl span{font-size:11px;color:var(--mut);overflow:hidden;text-overflow:ellipsis}
  .stp.ok .sn{background:#E4F3E8;color:#1E7E68}
  .stp.warn .sn{background:#FCF2DC;color:#B8860B}
  .stp.todo .sn{background:#FCE7E4;color:#C0392B}
  .stp.cur{border-color:var(--brand);box-shadow:0 0 0 3px rgba(36,130,200,.15)}
  .stp.cur .sl b{color:var(--brand)}
  .sar{align-self:center;color:#C2CEDA;font-size:18px;font-weight:bold}
  .rdi{background:#fff;border:1px solid var(--line);border-radius:11px;margin-bottom:10px;
       overflow:hidden;box-shadow:var(--sh)}
  .rdi.ok{border-left:4px solid var(--ok)}
  .rdi.warn{border-left:4px solid #E0A82E}
  .rdi.todo{border-left:4px solid #9DA6AB}
  .rdh{display:flex;align-items:center;gap:13px;padding:15px 18px;cursor:pointer;user-select:none}
  .rdh:hover{background:#F7FBFE}
  .rdh .no{width:26px;height:26px;border-radius:50%;background:#EDF4FB;color:var(--brand2);
           font-size:12px;font-weight:bold;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .rdh .tt{font-size:14px;font-weight:bold;color:var(--brand2);flex-shrink:0}
  .rdh .sm{font-size:12px;color:var(--mut)}
  .rdh .bg{margin-left:auto;font-size:12px;font-weight:bold;border-radius:20px;padding:4px 12px;white-space:nowrap}
  .rdh .bg.ok{background:#E4F3E8;color:#1E7E68}
  .rdh .bg.warn{background:#FCF2DC;color:#B8860B}
  .rdh .bg.todo{background:#EEF1F4;color:#5A6E78}
  .rdb{display:none;padding:0 18px 15px;border-top:1px solid #EEF3F8}
  .rdb.on{display:block}
  .rdsum{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px 22px;
         margin-bottom:16px;box-shadow:var(--sh);display:flex;align-items:center;gap:26px;flex-wrap:wrap}
  .rdsum .big{font-size:19px;font-weight:bold}
  .rdsum .big.go{color:var(--ok)} .rdsum .big.no{color:#B8860B}
  .mtx td.chk{min-width:210px;background:#FBFCFE}
  .chkbox{font-size:11px;line-height:1.75}
  .chkbox .hd{font-size:11px;color:var(--mut);margin-top:5px}
  .chkbox .hd:first-child{margin-top:0}
  .chkbox .nm{color:#3E4E64}
  .chkbox .sep{border-top:1px dashed #D6E0EA;margin:7px 0 6px}
  .chkbox .vd{font-weight:bold;font-size:12px;display:flex;align-items:center;gap:5px}
  .chkbox .vd.ok{color:var(--ok)} .chkbox .vd.ex{color:#B8860B} .chkbox .vd.ng{color:var(--err)}
  .chkbox .rs{font-size:10.5px;color:#8A6508;line-height:1.7;margin-top:3px}
  .lockbadge{display:inline-block;background:rgba(255,255,255,.22);color:#fff;font-size:10.5px;
             border-radius:20px;padding:2px 9px;margin-left:6px;vertical-align:1px}
  .nav{padding:0 12px}
  .nav a{display:block;padding:11px 15px;color:rgba(255,255,255,.88);text-decoration:none;
         font-size:13px;cursor:pointer;border-radius:9px;margin-bottom:3px;transition:.16s}
  .nav a:hover{background:rgba(255,255,255,.15);color:#fff}
  .nav a.on{background:#fff;color:#4E7FB8;font-weight:bold;
            box-shadow:0 3px 11px rgba(30,50,80,.2)}
  .navg{margin:10px 0 2px}
  .navg .gh{display:flex;align-items:center;gap:9px;padding:11px 15px;cursor:pointer;
            user-select:none;font-size:13px;font-weight:bold;color:rgba(255,255,255,.88);
            border-radius:9px;transition:.15s;margin-bottom:2px}
  .navg .gh:hover{background:rgba(255,255,255,.15);color:#fff}
  .navg .gh .ar{font-size:9px;width:10px;flex-shrink:0;transition:transform .18s;
                color:rgba(255,255,255,.7)}
  .navg.cl .gh .ar{transform:rotate(-90deg)}
  .navg .gb{overflow:hidden;max-height:500px;transition:max-height .22s}
  .navg.cl .gb{max-height:0}
  .navg .gb a{padding:11px 15px 11px 38px;font-size:13px;position:relative;
              color:rgba(255,255,255,.88)}
  .navg .gb a:before{content:'\203A';position:absolute;left:22px;top:50%;
                     transform:translateY(-52%);font-size:15px;font-weight:bold;
                     color:rgba(255,255,255,.55)}
  .navg .gb a:hover:before{color:#fff}
  .navg .gb a.on{color:#4E7FB8}
  .navg .gb a.on:before{color:#4E7FB8}
  .side .foot{position:sticky;top:100vh;padding:18px 20px 18px;font-size:11px;
              color:rgba(255,255,255,.64);line-height:1.7}
  .fl-sw{margin:0 0 12px;display:block;text-align:center;font-size:11.5px;
         border-color:rgba(255,255,255,.42);color:rgba(255,255,255,.86)}

  /* 본문 */
  .main{flex:1;padding:26px 30px;overflow-x:auto}
  .head{display:flex;align-items:baseline;gap:12px;margin-bottom:2px}
  .head h2{font-size:21px;color:var(--brand2);font-weight:bold}
  .head .desc{font-size:12px;color:var(--mut)}
  .bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:18px 0 14px}
  select,input[type=text]{font-family:inherit;font-size:12.5px;padding:7px 11px;
        border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);outline:none}
  select:focus,input[type=text]:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(36,130,200,.15)}
  input[type=text]{min-width:230px}
  label.chk{font-size:12.5px;display:flex;align-items:center;gap:5px;cursor:pointer;color:var(--mut)}
  button{font-family:inherit;font-size:12.5px;padding:7px 15px;border:1px solid var(--line);
         background:#fff;border-radius:8px;cursor:pointer;color:var(--ink);transition:.15s}
  button:hover{background:#EDF4FB;border-color:#BCCEDD}
  .btn-p{background:linear-gradient(135deg,#2482C8,#176BCE);color:#fff;border:none;font-weight:bold;
         box-shadow:0 3px 10px rgba(36,130,200,.3)}
  .btn-p:hover{filter:brightness(1.08);background:linear-gradient(135deg,#2482C8,#176BCE)}
  button:disabled{opacity:.45;cursor:not-allowed}
  button:disabled:hover{background:#fff;border-color:var(--line)}
  .btn-p:disabled:hover{background:linear-gradient(135deg,#2482C8,#176BCE)}
  .btn-ex{font-weight:bold;color:var(--brand)}
  .btn-ex:hover{background:var(--brand);color:#fff;border-color:var(--brand)}
  .cnt{font-size:12px;color:var(--mut);margin-left:auto}

  /* 통계 카드 — 순서대로 색이 달라진다 */
  .cards{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:20px}
  .card{background:var(--card);border-radius:12px;padding:17px 20px;min-width:142px;
        box-shadow:var(--sh);border:1px solid var(--line)}
  .card .n{font-size:27px;font-weight:bold;color:var(--brand2);line-height:1.15}
  .card .l{font-size:12px;color:var(--mut);margin-top:4px}
  .cards .card:nth-child(1),.cards .card:nth-child(2),
  .cards .card:nth-child(3),.cards .card:nth-child(4){border:none;color:#fff}
  .cards .card:nth-child(1){background:linear-gradient(135deg,#1D84FF,#2482C8)}
  .cards .card:nth-child(2){background:linear-gradient(135deg,#2482C8,#1768CB)}
  .cards .card:nth-child(3){background:linear-gradient(135deg,#2F5597,#176BCE)}
  .cards .card:nth-child(4){background:linear-gradient(135deg,#203864,#084E8E)}
  .cards .card:nth-child(-n+4) .n,.cards .card:nth-child(-n+4) .l{color:#fff}
  .cards .card:nth-child(-n+4) .l{opacity:.85}
  .cards .card:nth-child(-n+4){box-shadow:var(--sh2)}

  /* 패널 */
  .grid{display:flex;gap:16px;flex-wrap:wrap}
  .panel{background:var(--card);border:1px solid var(--line);border-radius:12px;
         padding:17px 20px;flex:1;min-width:280px;box-shadow:var(--sh)}
  .panel h3{font-size:13.5px;color:var(--brand2);margin-bottom:13px;font-weight:bold}
  .row{display:flex;align-items:center;gap:10px;margin:7px 0}
  .row .lab{width:132px;font-size:12px;flex-shrink:0;white-space:nowrap;overflow:hidden;
            text-overflow:ellipsis;color:#54637A}
  .row .barbg{flex:1;height:9px;background:#E8EFF6;border-radius:5px;overflow:hidden}
  .row .barfg{height:100%;background:linear-gradient(90deg,#1D84FF,#2482C8);border-radius:5px}
  .row .v{width:36px;text-align:right;font-size:12px;font-weight:bold;color:var(--brand2)}
  .prog{height:14px;background:#E8EFF6;border-radius:7px;overflow:hidden;margin:9px 0 5px}
  .prog span{display:block;height:100%;background:linear-gradient(90deg,#33A98C,#1E7E68)}
  .pb{display:inline-block;width:94px;height:9px;background:#E8EFF6;border-radius:5px;
      overflow:hidden;vertical-align:middle}
  .pb span{display:block;height:100%;background:linear-gradient(90deg,#33A98C,#1E7E68)}

  /* 표 */
  table{width:100%;border-collapse:collapse;background:#fff;font-size:12.5px}
  th{background:#EDF4FB;color:#203864;padding:11px 12px;text-align:left;font-weight:bold;
     position:sticky;top:0;white-space:nowrap;border-bottom:1px solid var(--line);font-size:12px}
  td{padding:10px 12px;border-bottom:1px solid #EEF3F8;vertical-align:top}
  tr:last-child td{border-bottom:none}
  tr:hover td{background:#F7FBFE}
  .tw{max-height:calc(100vh - 270px);overflow:auto;border:1px solid var(--line);
      border-radius:12px;background:#fff;box-shadow:var(--sh)}
  .mono{font-family:Consolas,'D2Coding',monospace;font-size:11.5px;color:#2F5597}

  .tag{display:inline-block;padding:3px 9px;border-radius:20px;font-size:11px;
       background:#E8EFF6;color:var(--mut);font-weight:bold}
  .tag.app{background:#E4F3E8;color:#1E7E68} .tag.db{background:#DCEBF9;color:#176BCE}
  .tag.os{background:#FCF2DC;color:#B8860B} .tag.tool{background:#F0E8FA;color:#6B4BA8}
  .tag.cpo{background:#FCE7E4;color:#C0392B} .tag.gen{background:#E8EFF6;color:#5A6E78}
  .tag.zero{background:#FCE7E4;color:#C0392B} .tag.has{background:#E4F3E8;color:#1E7E68}
  .done-b{display:inline-block;background:#E4F3E8;color:#1E7E68;border-radius:20px;
          padding:3px 10px;font-size:11.5px;font-weight:bold;margin-left:9px}
  .todo-b{display:inline-block;background:#FCF2DC;color:#B8860B;border-radius:20px;
          padding:3px 10px;font-size:11.5px;font-weight:bold;margin-left:9px}

  .tabs{display:flex;gap:6px;margin:16px 0 0;border-bottom:1px solid var(--line)}
  .tabs a{padding:9px 17px;font-size:12.5px;cursor:pointer;color:var(--mut);
          border-radius:9px 9px 0 0;transition:.15s}
  .tabs a:hover{background:#EDF4FB}
  .tabs a.on{background:#fff;color:var(--brand2);font-weight:bold;
             box-shadow:0 -2px 8px rgba(29,42,68,.05);border:1px solid var(--line);
             border-bottom-color:#fff;margin-bottom:-1px}

  .lv{font-weight:bold} .lv.OK{color:var(--ok)} .lv.WARN{color:var(--warn)} .lv.ERROR{color:var(--err)}
  .empty{padding:44px;text-align:center;color:var(--mut);background:#fff;
         border-radius:12px;border:1px solid var(--line)}
  /* 제출 완료 화면 */
  .fin{background:#fff;border:1px solid var(--line);border-radius:14px;padding:30px 28px;
       box-shadow:var(--sh);text-align:center}
  .fin .stamp{width:94px;height:94px;border-radius:50%;border:4px solid #1E7E68;
       display:flex;align-items:center;justify-content:center;margin:0 auto 16px;
       background:#EAF6F1;animation:stamp .5s cubic-bezier(.2,1.5,.4,1) both}
  @keyframes stamp{
    from{transform:rotate(-40deg) scale(2.1);opacity:0}
    to{transform:rotate(-11deg) scale(1);opacity:1}}
  @media (prefers-reduced-motion: reduce){
    .fin .stamp{animation:none;transform:rotate(-11deg)}}
  .fin .stamp i{font-size:15px;font-weight:bold;color:#14604E;line-height:1.25;font-style:normal}
  .fin h4{font-size:19px;font-weight:bold;color:var(--brand2);margin-bottom:6px}
  .fin p.sub{font-size:13px;color:var(--mut);line-height:1.8;margin-bottom:20px}
  .fin .kpi{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:22px}
  .fin .kpi div{background:#F3F7FB;border-radius:10px;padding:12px 22px;min-width:104px}
  .fin .kpi .k{font-size:11.5px;color:var(--mut)}
  .fin .kpi .v{font-size:22px;font-weight:bold;margin-top:3px}
  .fin .kpi .v.g{color:#1E7E68} .fin .kpi .v.b{color:#2482C8} .fin .kpi .v.w{color:#B8860B}
  .fin .list{border-top:1px solid var(--line);padding-top:16px;text-align:left;
       max-width:520px;margin:0 auto;display:flex;flex-direction:column;gap:9px}
  .fin .list .it{display:flex;align-items:center;gap:9px;font-size:13px;color:#50646E}
  .fin .list .it .ck{color:#1E7E68;font-weight:bold;font-size:14px}
  .fin .list .it .cnt2{margin-left:auto;font-size:11.5px;color:var(--mut)}
  .warnbar{background:#FBF4E3;border:1px solid #E8D9A8;border-radius:10px;padding:12px 16px;
           font-size:12.5px;color:#8A6508;line-height:1.8;margin-bottom:14px}
  .warnbar b{color:#6B4F06}
  .mlsel{width:34px;text-align:center}
  .prev{border:1px solid var(--line);border-radius:10px;background:#F3F7FB;padding:14px;
        max-height:60vh;overflow:auto}
  .load{padding:44px;text-align:center;color:var(--mut)}
  .err{margin:16px 0;padding:14px 17px;border:1px solid #F0C8C2;background:#FDF1EF;
       color:#A03126;border-radius:10px}
  .note{font-size:11.5px;color:var(--mut);margin-top:9px;line-height:1.7}
  .msg{font-size:12px;padding:4px 0}
  .msg.ok{color:var(--ok)} .msg.er{color:var(--err)}
  /* 카드 위에 덮이는 결과 알럿. 확인을 눌러야 사라진다 */
  .ca{display:none;position:absolute;inset:0;z-index:20;border-radius:10px;
      background:rgba(255,255,255,.9);backdrop-filter:blur(2px);
      -webkit-backdrop-filter:blur(2px);align-items:center;justify-content:center;padding:18px}
  .ca.on{display:flex}
  .ca-box{background:#fff;border-radius:12px;padding:20px 24px;min-width:min(440px,92%);
          max-width:96%;text-align:center;box-shadow:0 10px 34px rgba(30,50,80,.22);
          border-top:5px solid;position:relative}
  .ca.ok .ca-box{border-color:#1E7E68} .ca.er .ca-box{border-color:#C0392B}
  .ca.wk .ca-box{border-color:#B8860B}
  .ca-ic{font-size:30px;line-height:1;margin-bottom:10px}
  .ca.ok .ca-ic{color:#1E7E68} .ca.er .ca-ic{color:#C0392B} .ca.wk .ca-ic{color:#B8860B}
  .ca-t{font-size:15px;font-weight:bold;margin-bottom:6px}
  .ca.ok .ca-t{color:#14604E} .ca.er .ca-t{color:#96291D} .ca.wk .ca-t{color:#8A6508}
  .ca-s{font-size:12.5px;color:var(--mut);line-height:1.7;margin-bottom:15px;word-break:break-all}
  .ca-btn{font-size:13px;padding:8px 26px;border:1px solid #CFD7DE;background:#F2F5F8;
          border-radius:8px;cursor:pointer;color:#50646E;font-weight:bold;transition:.15s}
  .ca-btn:hover{background:#E6EBF0;border-color:#B4BCC4;color:#2B323D}
  .ca-x{position:absolute;top:9px;right:13px;font-size:19px;color:#9DA6AB;cursor:pointer;line-height:1}
  .ca-x:hover{color:var(--err)}

  /* 제출 요약 */
  .sum{background:#fff;border:1px solid var(--line);border-radius:12px;padding:20px 22px;
       margin-bottom:16px;box-shadow:var(--sh)}
  .sum .n{display:flex;gap:34px;align-items:baseline;flex-wrap:wrap}
  .sum .n b{font-size:27px;color:var(--brand2)} .sum .n b.g{color:var(--ok)} .sum .n b.w{color:var(--warn)}
  .sum .n span{font-size:12px;color:var(--mut);margin-left:5px}
  .sum .pg{height:13px;background:#E8EFF6;border-radius:7px;overflow:hidden;margin:14px 0 6px}
  .sum .pg span{display:block;height:100%;background:linear-gradient(90deg,#33A98C,#1E7E68);transition:width .3s}
  .sum .due{font-size:12px;color:var(--mut)}
  .sum .due b{color:var(--err)}

  /* 평가단위 그룹 */
  .grp{background:#fff;border:1px solid var(--line);border-radius:12px;margin-bottom:11px;
       overflow:hidden;box-shadow:var(--sh)}
  .grp.done{border-left:4px solid var(--ok)} .grp.todo{border-left:4px solid #E0A82E}
  .grp-h{display:flex;align-items:center;gap:12px;padding:15px 18px;cursor:pointer;user-select:none}
  .grp-h:hover{background:#F7FBFE}
  .grp-h .ar{color:var(--mut);font-size:11px;width:11px}
  .grp-h .nm{font-size:14px;font-weight:bold;color:var(--brand2)}
  .grp-h .id{font-size:11.5px;color:var(--mut)}
  .grp-h .st{margin-left:auto;display:flex;gap:11px;align-items:center}
  .grp-h .ct{font-size:13px;font-weight:bold;color:var(--mut)}
  .grp-h .ct.g{color:var(--ok)} .grp-h .ct.w{color:var(--warn)}
  .dots span{display:inline-block;width:9px;height:9px;border-radius:50%;margin-left:4px;
             background:#F0D08A;border:1px solid #D9AE4E}
  .dots span.f{background:#33A98C;border-color:#1E7E68}
  .grp-b{display:none;padding:0 18px 15px;border-top:1px solid #EEF3F8}
  .grp-b.on{display:block}

  /* 증빙 항목 */
  .up{background:#FAFCFE;border:1px solid var(--line);border-radius:10px;padding:16px 18px;margin-top:11px}
  .up.done{border-left:3px solid var(--ok)} .up.todo{border-left:3px solid #E0A82E}
  .up[data-def]{outline:none;cursor:default;position:relative;transition:box-shadow .15s,border-color .15s}
  .up.act{border-color:var(--brand);box-shadow:0 0 0 3px rgba(36,130,200,.16)}
  .up.act .paste{border-color:var(--brand);background:#EDF4FB;color:var(--brand2);font-weight:bold}
  .up.saving{opacity:.6;pointer-events:none;position:relative}
  .up .ov{display:none;position:absolute;inset:0;background:rgba(255,255,255,.8);
          border-radius:10px;align-items:center;justify-content:center;
          font-size:13px;color:var(--brand2);font-weight:bold;z-index:5}
  .up.saving .ov{display:flex}
  .up .t{font-size:14px;font-weight:bold;color:var(--brand2);margin-bottom:5px}
  .up .m{font-size:11.5px;color:var(--mut);line-height:1.75;margin:4px 0}
  .up .m b{color:#2B323D}
  .up .m.rng{background:#EDF4FB;border-radius:6px;padding:5px 10px;display:inline-block;
             color:#2F5597;margin:3px 0}
  .up .m.rng b{color:#176BCE}
  .seg{border:1px solid #CAD9E8;border-radius:9px;margin-top:11px;overflow:hidden}
  .seg.done{border-color:#BFE0D3}
  .seg-h{display:flex;align-items:center;gap:10px;padding:9px 13px;background:#EDF4FB;
         font-size:12px;color:#2F5597}
  .seg.done .seg-h{background:#EAF6F1;color:#14604E}
  .seg-h .no{width:20px;height:20px;border-radius:50%;background:#2482C8;color:#fff;
             font-size:10.5px;font-weight:bold;display:flex;align-items:center;
             justify-content:center;flex-shrink:0}
  .seg.done .seg-h .no{background:#1E7E68}
  .seg-h .hs{font-weight:bold}
  .seg-h .pd{color:#5A6E78}
  .seg-h .st{margin-left:auto;font-size:11px;font-weight:bold}
  .seg-b{padding:11px 13px}
  .refbox{background:#F3F7FB;border:1px solid #CAD9E8;border-left:4px solid #2482C8;
          border-radius:9px;padding:12px 15px;margin-top:11px;font-size:12px;
          color:#2F5597;line-height:1.8}
  .refbox b{color:#203864}
  .up .m.shared{color:#176BCE;background:#F3F7FB;border-radius:4px;padding:3px 8px;display:inline-block}
  .refbox .src{font-size:11.5px;color:#5A6E78;margin-top:3px;display:block}
  .up.ref{background:#FAFCFE;border-left:3px solid #2482C8}
  .ref-b{display:inline-block;background:#EDF4FB;color:#176BCE;border-radius:20px;
         padding:3px 10px;font-size:11.5px;font-weight:bold;margin-left:9px}
  .parthint{background:#FBF4E3;border:1px solid #E8D9A8;border-radius:8px;padding:9px 12px;
            font-size:11.5px;color:#8A6508;line-height:1.75;margin-top:9px}
  .up .act{display:flex;gap:9px;align-items:center;margin-top:11px;flex-wrap:wrap}
  .up .fl{font-size:12px;background:#EDF4FB;border:1px solid #CAD9E8;border-radius:8px;
          padding:8px 12px;display:flex;gap:11px;align-items:center;margin-top:7px}
  .up .fl a{color:var(--brand);font-weight:bold;text-decoration:none}
  .up .fl a:hover{text-decoration:underline}
  .up .fl .by{background:#fff;border:1px solid #CAD9E8;border-radius:20px;padding:2px 9px;
              font-size:11px;color:#2F5597;font-weight:bold}
  .up .fl .x{cursor:pointer;color:var(--err);font-size:11.5px;margin-left:auto}

  .paste{border:2px dashed #BCCEDD;border-radius:10px;background:#F7FBFE;padding:17px;
         text-align:center;font-size:12px;color:var(--mut);cursor:text;outline:none;margin-top:10px;
         transition:.15s}
  .paste:focus{border-color:var(--brand);background:#EDF4FB;color:var(--brand2)}
  .paste.busy{border-color:var(--warn);color:var(--warn)}
  .pv{margin-top:9px;border:1px solid var(--line);border-radius:10px;overflow:auto;
      max-height:230px;background:#fff}
  .pv table{font-size:11.5px} .pv th{position:static;font-size:11px;padding:7px 9px}
  .pv td{padding:6px 9px;white-space:nowrap}
  .pvbar{display:flex;gap:9px;align-items:center;margin-top:9px;font-size:12px;color:var(--mut)}

  /* 과거 예시 */
  .ex{margin-top:12px;padding:13px 15px;background:#F7FBFE;border:1px solid #CAD9E8;border-radius:10px}
  .ex .h{font-size:12px;font-weight:bold;color:var(--brand2);margin-bottom:6px}
  .ex .d{font-size:11.5px;color:var(--mut);line-height:1.7;margin-bottom:9px}
  .exf{font-size:12px;color:var(--brand)}
  .extog{font-size:12px;color:var(--brand);cursor:pointer;user-select:none;font-weight:bold;margin-top:8px;
         display:inline-block}
  .extog:hover{text-decoration:underline}
  .exbody{display:none;margin-top:8px} .exbody.on{display:block}
  .thumb{max-width:280px;max-height:160px;border:1px solid var(--line);border-radius:8px;
         margin-top:9px;cursor:zoom-in;display:block}

  /* 토스트 · 모달 */
  .toast{position:fixed;top:20px;left:50%;transform:translateX(-50%) translateY(-90px);
         background:linear-gradient(135deg,#1E7E68,#166052);color:#fff;padding:14px 24px;
         border-radius:12px;z-index:1000;box-shadow:0 10px 34px rgba(0,0,0,.24);font-size:13.5px;
         opacity:0;transition:transform .26s,opacity .26s;max-width:82vw}
  .toast.on{transform:translateX(-50%) translateY(0);opacity:1}
  .toast.er{background:linear-gradient(135deg,#C0392B,#8E2A1F)}
  .toast.wk{background:linear-gradient(135deg,#B8860B,#8A6508)}
  .toast b{display:block;font-size:14.5px;margin-bottom:3px}
  .toast .sub{font-size:12px;opacity:.85}
  .mo{position:fixed;inset:0;background:rgba(32,56,100,.42);backdrop-filter:blur(5px);
      -webkit-backdrop-filter:blur(5px);z-index:900;display:none;align-items:center;
      justify-content:center;padding:36px}
  .mo.on{display:flex}
  .mo-box{background:#fff;border-radius:14px;box-shadow:0 22px 70px rgba(0,0,0,.3);
          max-width:min(1100px,92vw);max-height:88vh;display:flex;flex-direction:column;overflow:hidden}
  .mo-h{display:flex;align-items:center;gap:13px;padding:15px 20px;border-bottom:1px solid var(--line);
        background:#EDF4FB}
  .mo-h .ti{font-size:14px;font-weight:bold;color:var(--brand2)}
  .mo-h .su{font-size:11.5px;color:var(--mut)}
  .mo-h .cl{margin-left:auto;cursor:pointer;font-size:23px;color:var(--mut);line-height:1}
  .mo-h .cl:hover{color:var(--err)}
  .mo-b{padding:16px 20px;overflow:auto}
  .mo-b img{max-width:100%;display:block;cursor:zoom-in;border:1px solid var(--line);border-radius:8px}
  .mo-f{padding:12px 20px;border-top:1px solid var(--line);font-size:11.5px;color:var(--mut);
        display:flex;gap:10px;align-items:center}
  .mo-f a,.exf,.up .fl a{color:var(--brand)}
  .lb{position:fixed;inset:0;background:rgba(20,32,56,.9);z-index:999;display:none;
      align-items:center;justify-content:center;padding:28px;cursor:zoom-out}
  .lb.on{display:flex}
  .lb img{max-width:100%;max-height:100%;box-shadow:0 8px 40px rgba(0,0,0,.5);border-radius:8px}
  .lb .close{position:absolute;top:16px;right:24px;color:#fff;font-size:28px;cursor:pointer;
             line-height:1;font-weight:bold}
  .lb .hint{position:absolute;bottom:18px;left:0;right:0;text-align:center;color:#9FB0C4;font-size:12px}

  .spin{display:inline-block;width:13px;height:13px;margin-right:9px;border:2px solid #CAD9E8;
        border-top-color:var(--brand);border-radius:50%;animation:sp .7s linear infinite;vertical-align:-2px}
  @keyframes sp{to{transform:rotate(360deg)}}
</style>
</head>
<body>
<div class="toast" id="toast"></div>
<div class="mo" id="mo" onclick="closeMo(event)">
  <div class="mo-box" onclick="event.stopPropagation()">
    <div class="mo-h"><span class="ti" id="moTi">과거 예시</span>
      <span class="su" id="moSu"></span><span class="cl" onclick="closeMo()">&times;</span></div>
    <div class="mo-b" id="moB"><div class="load">불러오는 중…</div></div>
    <div class="mo-f" id="moF"></div>
  </div>
</div>
<div class="lb" id="lb" onclick="closeLb()">
  <span class="close">&times;</span>
  <img id="lbImg" src="" onclick="event.stopPropagation()">
  <div class="hint">이미지 바깥을 클릭하거나 ESC를 누르면 닫힙니다</div>
</div>
<div class="wrap">
  <div class="side">
    <h1>내부회계관리제도<br>ITGC 관리자시스템</h1>
    <div class="sub" id="sideSub">불러오는 중…</div>
    <div class="pdsw" id="pdSw" onclick="openPeriod()" style="display:none">기수 전환</div>
    <div class="nav" id="nav"></div>
    <div class="foot">
      <div class="pdsw fl-sw" id="lkSw" onclick="openLock()" style="display:none">운영평가 완료</div>
      <div id="sideFoot"></div>
    </div>
  </div>
  <div class="main"><div id="view"><div class="load">데이터를 불러오는 중입니다…</div></div></div>
</div>

<script>
var DATA=null, V='dash', EVTAB='list';

function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
function el(id){ return document.getElementById(id); }

google.script.run.withSuccessHandler(onBoot).withFailureHandler(onFail).getBootstrap();

function onFail(e){ el('view').innerHTML='<div class="err"><b>호출 실패</b><br>'+esc(e&&e.message)+'</div>'; }
function onBoot(res){
  if(!res||!res.ok){ onFail({message:res?res.error:'응답 없음'}); return; }
  DATA=res;
  /* 서버 파일(Api.gs)이 이전 버전이어도 화면이 멈추지 않도록 기본값을 채운다 */
  DATA.files = DATA.files || [];
  DATA.evidence = DATA.evidence || [];
  DATA.users = DATA.users || [];
  DATA.evalUnits = DATA.evalUnits || [];
  DATA.meta = DATA.meta || {};
  if(!DATA.meta.maxMb) DATA.meta.maxMb = 10;
  if(!res.files){
    toast('서버 코드가 이전 버전입니다','Api.gs를 최신본으로 교체한 뒤 다시 배포하십시오','er');
  }
  var m=res.meta;
  el('sideSub').innerHTML=esc(m.periodLabel||m.period)+
    (m.locked?'<span class="lockbadge">잠김</span>':'');
  var mu=meUser();
  if(mu && mu.role==='관리자'){
    el('pdSw').style.display='inline-block';
    var lk=el('lkSw');
    lk.style.display='inline-block';
    lk.textContent = m.locked ? '잠금 해제' : '운영평가 완료';
  }
  el('sideFoot').innerHTML='모드 '+esc(m.mode)+' · 메일 '+esc(m.mailEnabled)+'<br>'+
    '증빙 마감 '+esc(m.dueDate)+'<br>'+esc(m.user);
  loadNavState();
  /* 새로고침해도 보던 화면이 유지되도록 복원한다 */
  restoreView(function(v, u){
    var ok={dash:1,eu:1,ev:1,up:1,cs:1,ml:1,rd:1,dt:1,sys:1,inf:1,hc:1};
    if(v && ok[v]) V=v;
    if(u) UPUSER=u;
    renderNav(); render();
  });
}
var NAV=[
  {v:'dash', t:'대시보드'},
  {v:'hc',   t:'점검'},
  {g:'s1', t:'Step 1. 변동사항 점검', items:[
    {v:'rd', t:'운영평가 사전 점검'}, {v:'dt', t:'업무분장 검토'},
    {v:'inf', t:'인프라'}, {v:'sys', t:'시스템'}]},
  {g:'s2', t:'Step 2. 증빙 사전 정의', items:[
    {v:'eu', t:'평가단위'}, {v:'ev', t:'증빙정의'}]},
  {g:'s3', t:'Step 3. 증빙요청 및 수취', items:[
    {v:'ml', t:'담당자 요청메일 발송'}, {v:'up', t:'증빙제출'}, {v:'cs', t:'수집현황'}]}
];
var NAVCL={};
function loadNavState(){
  try{
    var v=sessionStorage.getItem('itgc_nav');
    if(v) NAVCL=JSON.parse(v);
  }catch(e){}
}
function saveNavState(){
  try{ sessionStorage.setItem('itgc_nav', JSON.stringify(NAVCL)); }catch(e){}
}
function renderNav(){
  var h='';
  NAV.forEach(function(n){
    if(n.v){ h+='<a data-v="'+n.v+'">'+esc(n.t)+'</a>'; return; }
    var cl=NAVCL[n.g]?' cl':'';
    h+='<div class="navg'+cl+'" id="ng_'+n.g+'">'+
       '<div class="gh" onclick="navTog(\''+n.g+'\')">'+
       '<span class="ar">\u25BC</span><span>'+esc(n.t)+'</span></div><div class="gb">';
    n.items.forEach(function(x){ h+='<a data-v="'+x.v+'">'+esc(x.t)+'</a>'; });
    h+='</div></div>';
  });
  el('nav').innerHTML=h;
  var as=document.querySelectorAll('.nav a');
  for(var i=0;i<as.length;i++){
    as[i].onclick=function(){
      V=this.getAttribute('data-v');
      setNav(); saveView(); render();
      window.scrollTo(0,0);
    };
  }
  setNav();
}
function navTog(g){
  NAVCL[g]=!NAVCL[g];
  var e=el('ng_'+g);
  if(e) e.className='navg'+(NAVCL[g]?' cl':'');
  saveNavState();
}
function setNav(){
  var as=document.querySelectorAll('.nav a');
  for(var j=0;j<as.length;j++){
    as[j].className = (as[j].getAttribute('data-v')===V) ? 'on' : '';
  }
}
/* 현재 화면을 주소와 세션에 기록한다 */
function saveView(){
  try{ sessionStorage.setItem('itgc_v', V); }catch(e){}
  try{ if(UPUSER) sessionStorage.setItem('itgc_u', UPUSER); }catch(e){}
  try{
    var pr={v:V};
    if(V==='up' && UPUSER) pr.u=UPUSER;
    google.script.history.replace(null, pr);
  }catch(e){}
}
function restoreView(cb){
  var done=false, v=null, u=null;
  try{ v=sessionStorage.getItem('itgc_v')||null; u=sessionStorage.getItem('itgc_u')||null; }catch(e){}
  var fin=function(pv,pu){ if(done) return; done=true; cb(pv||v, pu||u); };
  setTimeout(function(){ fin(null,null); }, 1000);
  try{
    google.script.url.getLocation(function(loc){
      var q=(loc&&loc.parameter)||{};
      fin(q.v||null, q.u||null);
    });
  }catch(e){ fin(null,null); }
}
function render(){
  ({dash:viewDash,eu:viewEu,ev:viewEv,up:viewUp,cs:viewCs,ml:viewMl,rd:viewRd,dt:viewDt,sys:viewSys,inf:viewInf,hc:viewHc})[V]();
}

/* ── 공통 ─────────────────────────────── */
/* 잠긴 기수에서 상단에 표시하는 안내 */
function lockBar(){
  var m=DATA.meta;
  if(!m.locked) return '';
  var who=userName(m.lockedBy);
  var adm=(meUser()||{}).role==='관리자';
  return '<div class="lockbar"><b>운영평가 완료로 잠겨 있습니다.</b> '+
    '증빙 업로드·삭제·수집 확인이 차단됩니다.<br>'+
    esc(m.lockedAt||'')+(who?' · '+esc(who):'')+' 잠금'+
    '<span class="sp">'+(adm?'<button onclick="openLock()">잠금 해제</button>':'')+'</span></div>';
}
function head(t,d){ return '<div class="head"><h2>'+esc(t)+'</h2><span class="desc">'+esc(d)+'</span></div>'; }
function card(n,l,cls){ return '<div class="card"><div class="n '+(cls||'')+'">'+n+'</div><div class="l">'+esc(l)+'</div></div>'; }
function barPanel(t,arr){
  var max=0; arr.forEach(function(x){ if(x.count>max) max=x.count; });
  var h='<div class="panel"><h3>'+esc(t)+'</h3>';
  arr.forEach(function(x){
    var w=max?Math.round(x.count/max*100):0;
    h+='<div class="row"><span class="lab" title="'+esc(x.label)+'">'+esc(x.label)+'</span>'+
       '<span class="barbg"><span class="barfg" style="width:'+w+'%"></span></span>'+
       '<span class="v">'+x.count+'</span></div>';
  });
  return h+'</div>';
}
function layerTag(v){ return '<span class="tag '+esc(String(v||'').toLowerCase())+'">'+esc(v)+'</span>'; }
function zoneTag(v){ return v?'<span class="tag '+(v==='선불망'?'cpo':'gen')+'">'+esc(v)+'</span>':''; }
function opts(id,arr,label){
  var h='<select id="'+id+'"><option value="">'+esc(label)+' 전체</option>';
  arr.forEach(function(v){ h+='<option>'+esc(v)+'</option>'; });
  return h+'</select>';
}
function table(cols,rows,fn){
  if(!rows.length) return '<div class="tw"><div class="empty">해당하는 데이터가 없습니다</div></div>';
  var h='<div class="tw"><table><thead><tr>';
  cols.forEach(function(c){ h+='<th>'+esc(c)+'</th>'; });
  h+='</tr></thead><tbody>';
