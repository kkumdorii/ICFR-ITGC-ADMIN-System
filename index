  var ci=r.ccInfo||{};
  if(ci.leaderCount>0) return '';
  var ls=(ci.leaders||[]);
  var h='<div style="background:#FBF4E3;border:1px solid #E8D9A8;border-radius:8px;'+
        'padding:9px 12px;margin:6px 0;font-size:11.5px;color:#8A6508;line-height:1.8">'+
        '<b>부서 팀장이 참조에 들어가지 않았습니다.</b><br>'+
        '수신자 소속부서 : <b>'+esc(ci.dept||'(없음)')+'</b><br>';
  if(!ls.length) h+='M_사용자에 팀장여부 = Y 인 행이 하나도 없습니다.';
  else{
    h+='등록된 팀장 '+ls.length+'명 : ';
    h+=ls.map(function(x){ return esc(x.name)+'('+esc(x.dept)+')'; }).join(', ');
    h+='<br>위 부서명과 정확히 일치하는 팀장이 없습니다. 소속부서 표기를 확인하십시오.';
  }
  return h+'</div>';
}
function mlPreview(uid){
  el('moTi').textContent='메일 본문 미리보기';
  el('moSu').textContent='';
  el('moB').innerHTML='<div class="load"><span class="spin"></span>본문을 만드는 중…</div>';
  el('moF').innerHTML='';
  el('mo').className='mo on';
  google.script.run.withSuccessHandler(function(r){
    if(!r.ok){ el('moB').innerHTML='<div class="err">'+esc(r.error)+'</div>'; return; }
