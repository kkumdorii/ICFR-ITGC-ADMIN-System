  var me=meUser();
  DATA.files.push({fileId:r.fileId, euId:d?d.euId:'', defId:defId, name:r.name,
                   url:r.url, size:r.size||0, at:nowStr(), by:me?me.id:''});
  if(PENDMSG) PENDMSG.defId=defId;
  drawUp();
}
function delFileLocal(fileId, title, sub){
  var gone=null;
  DATA.files.forEach(function(f){ if(f.fileId===fileId) gone=f; });
  DATA.files=DATA.files.filter(function(f){ return f.fileId!==fileId; });
  if(gone && title) PENDMSG={kind:'wk', title:title, sub:sub, defId:gone.defId};
  drawUp();
}
function nowStr(){
  var d=new Date(), p=function(n){ return ('0'+n).slice(-2); };
  return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+' '+
         p(d.getHours())+':'+p(d.getMinutes())+':'+p(d.getSeconds());
}
function refreshFiles(cb){
  google.script.run.withSuccessHandler(function(r){
    if(r.ok){ DATA.files=r.files; drawUp(); }
    if(cb) cb();
  }).withFailureHandler(onFail).getFilesOnly();
}

function openFolder(euId){
  google.script.run.withSuccessHandler(function(r){
    if(r.ok) window.open(r.url,'_blank'); else alert(r.error);
  }).withFailureHandler(onFail).getEvidenceFolderUrl(euId);
}
function scanMine(){
  el('upMsg').innerHTML='<div class="msg">폴더를 확인하는 중…</div>';
  google.script.run.withSuccessHandler(function(r){
    if(!r.ok){ el('upMsg').innerHTML='<div class="err">'+esc(r.error)+'</div>'; return; }
    var m='<div class="msg ok">파일 '+r.scanned+'건 확인 · 신규 등록 '+r.assigned.length+'건';
    if(r.unassigned.length) m+=' · 미분류 '+r.unassigned.length+'건 (수집현황 화면에서 지정)';
    el('upMsg').innerHTML=m+'</div>';
    toast('수집 확인 완료', '신규 등록 '+r.assigned.length+'건'+
          (r.unassigned.length?' · 미분류 '+r.unassigned.length+'건':''),
          r.unassigned.length?'wk':'');
    refreshFiles();
  }).withFailureHandler(onFail).scanEvidence(null);
}

/* ── 수집현황 ─────────────────────────── */
var UNASSIGNED=[];
function viewCs(){
  var users={}; DATA.users.forEach(function(u){ users[u.id]=u; });
  var euMap={}; DATA.evalUnits.forEach(function(r){ euMap[r.id]=r; });
  var up={}; DATA.files.forEach(function(f){ up[f.defId]=(up[f.defId]||0)+1; });
  /* 참조 증빙은 원본 한 건만 세므로 집계에서 제외한다 */
  var defs=DATA.evidence.filter(function(d){ return d.status==='사용' && !d.refId; });
  var byUser={}, byEu={}, rows=[];
  defs.forEach(function(d){
    var done=!!up[d.id], uid=String(d.ownerId||'(미지정)'), eu=euMap[d.euId]||{};
    if(!byUser[uid]) byUser[uid]={total:0,done:0};
    byUser[uid].total++; if(done) byUser[uid].done++;
    if(!byEu[d.euId]) byEu[d.euId]={total:0,done:0,control:eu.control||'',target:eu.target||''};
    byEu[d.euId].total++; if(done) byEu[d.euId].done++;
    rows.push({defId:d.id, euId:d.euId, seq:d.seq, type:d.type,
      owner:users[uid]?users[uid].name:(d.ownerId||'(미지정)'),
      dept:users[uid]?users[uid].dept:'', done:done});
  });
  var total=defs.length, doneN=defs.filter(function(d){ return !!up[d.id]; }).length;
  var pct=total?Math.round(doneN/total*100):0;

  var h=head('수집현황', DATA.meta.periodLabel||DATA.meta.period)+lockBar();
  h+='<div class="bar"><button class="btn-p" onclick="scanAll()">전체 폴더 스캔</button>'+
     '<button onclick="reloadAll()">데이터 새로고침</button>'+
     '<span style="font-size:11.5px;color:var(--muted)">Drive에 직접 올라온 파일을 찾아 등록합니다</span></div>';
  h+='<div id="csMsg"></div>';
  h+='<div class="cards" id="csCards">'+card(total,'요청 증빙')+card(doneN,'수집 완료','g')+
     card(total-doneN,'미제출',(total-doneN)?'w':'g')+card(pct+'%','수집률')+'</div>';
  h+='<div id="csUn"></div><div style="height:14px"></div>';
  h+='<div class="grid"><div class="panel"><h3>담당자별</h3>'+
     table(['담당자','부서','진행','건수'],
       Object.keys(byUser).sort().map(function(k){
         return {name:users[k]?users[k].name:k, dept:users[k]?users[k].dept:'',
                 total:byUser[k].total, done:byUser[k].done};
       }), function(r){
       var p=r.total?Math.round(r.done/r.total*100):0;
       return '<td>'+esc(r.name)+'</td><td>'+esc(r.dept)+'</td>'+
         '<td><span class="pb"><span style="width:'+p+'%"></span></span> '+p+'%</td>'+
         '<td>'+r.done+' / '+r.total+'</td>';
     })+'</div>';
  h+='<div class="panel"><h3>평가단위별</h3>'+
     table(['평가단위ID','통제','대상명','건수'],
       Object.keys(byEu).sort().map(function(k){
         return {euId:k, control:byEu[k].control, target:byEu[k].target,
                 total:byEu[k].total, done:byEu[k].done};
       }), function(r){
       return '<td class="mono">'+esc(r.euId)+'</td><td>'+esc(r.control)+'</td>'+
         '<td>'+esc(r.target)+'</td><td>'+r.done+' / '+r.total+'</td>';
     })+'</div></div>';
  h+='<div style="height:14px"></div><div class="panel"><h3>미제출 목록</h3>'+
     table(['정의ID','평가단위ID','순번','증빙유형','담당자','부서'],
       rows.filter(function(r){ return !r.done; }), function(r){
       return '<td class="mono">'+esc(r.defId)+'</td><td class="mono">'+esc(r.euId)+'</td>'+
         '<td>'+esc(r.seq)+'</td><td>'+esc(r.type)+'</td>'+
         '<td>'+esc(r.owner)+'</td><td>'+esc(r.dept)+'</td>';
     })+'</div>';
  el('view').innerHTML=h;
  drawUnassigned();
}
function reloadAll(){
  toast('데이터를 다시 불러옵니다','','');
  google.script.run.withSuccessHandler(function(res){
    if(res && res.ok){ DATA=res; render(); toast('갱신되었습니다','','');}
  }).withFailureHandler(onFail).getBootstrap();
}
function scanAll(){
  el('csMsg').innerHTML='<div class="msg"><span class="spin"></span>전체 폴더를 확인하는 중…</div>';
  google.script.run.withSuccessHandler(function(r){
    if(!r.ok){ el('csMsg').innerHTML='<div class="err">'+esc(r.error)+'</div>'; return; }
    UNASSIGNED=r.unassigned;
    el('csMsg').innerHTML='<div class="msg ok">파일 '+r.scanned+'건 확인 · 신규 등록 '+
      r.assigned.length+'건 · 미분류 '+r.unassigned.length+'건</div>';
    google.script.run.withSuccessHandler(function(f){
      if(f.ok){ DATA.files=f.files; viewCs(); }
    }).getFilesOnly();
  }).withFailureHandler(onFail).scanEvidence(null);
}
function drawUnassigned(){
  var box=el('csUn');
  if(!box) return;
  if(!UNASSIGNED.length){ box.innerHTML=''; return; }
  var h='<div class="panel"><h3>미분류 파일 '+UNASSIGNED.length+'건</h3>'+
        '<div class="note">확장자만으로 증빙정의가 특정되지 않은 파일입니다. 연결할 증빙을 직접 지정하십시오.</div>';
  h+='<div class="tw" style="max-height:420px"><table><thead><tr>'+
     '<th>파일명</th><th>평가단위ID</th><th>사유</th><th>연결할 증빙</th><th></th></tr></thead><tbody>';
  UNASSIGNED.forEach(function(u,i){
    var sel='<select id="ua'+i+'">';
    u.candidates.forEach(function(c){
      sel+='<option value="'+esc(c.defId)+'">'+esc(c.defId)+' · 순번'+esc(c.seq)+' · '+
           esc(String(c.type).substring(0,34))+'</option>';
    });
    sel+='</select>';
    h+='<tr><td><a href="'+esc(u.url)+'" target="_blank">'+esc(u.name)+'</a><br>'+
       '<span style="color:#889">'+Math.round((u.size||0)/1024)+'KB</span></td>'+
       '<td class="mono">'+esc(u.euId)+'</td><td>'+esc(u.reason)+'</td>'+
       '<td>'+(u.candidates.length?sel:'<span class="lv WARN">해당 평가단위에 증빙정의 없음</span>')+'</td>'+
       '<td>'+(u.candidates.length?'<button onclick="doAssign('+i+',\''+esc(u.driveFileId)+'\')">연결</button>':'')+
       '</td></tr>';
  });
  box.innerHTML=h+'</tbody></table></div></div>';
}
function doAssign(i, driveFileId){
  var defId=el('ua'+i).value;
  google.script.run.withSuccessHandler(function(r){
    if(!r.ok){ toast('연결하지 못했습니다', r.error, 'er'); return; }
    UNASSIGNED.splice(i,1);
    toast('연결되었습니다', r.name, '');
    google.script.run.withSuccessHandler(function(f){
      if(f.ok){ DATA.files=f.files; viewCs(); }
    }).getFilesOnly();
  }).withFailureHandler(onFail).assignEvidence(driveFileId, defId);
}

/* ── 점검 ─────────────────────────────── */
var HCLAST=null;
function viewHc(force){
  if(HCLAST && !force){ drawHc(HCLAST); return; }
  el('view').innerHTML=head('점검','설정값 · FK 정합성')+
    '<div class="load"><span class="spin"></span>점검 중입니다…</div>';
  google.script.run.withSuccessHandler(function(r){ HCLAST=r; drawHc(r); })
    .withFailureHandler(onFail).getHealthCheck(false);
}
function runDriveCheck(){
  el('dvBox').innerHTML='<div class="load"><span class="spin"></span>Drive 폴더를 확인하는 중…</div>';
  google.script.run.withSuccessHandler(function(r){
    if(!r.ok){ el('dvBox').innerHTML='<div class="err">'+esc(r.error)+'</div>'; return; }
    el('dvBox').innerHTML=table(['구분','설정키','내용'],r.config,function(x){
      return '<td class="lv '+esc(x.level)+'">'+esc(x.level)+'</td><td class="mono">'+
             esc(x.key)+'</td><td>'+esc(x.msg)+'</td>';
    });
  }).withFailureHandler(onFail).getDriveCheck();
}
function drawHc(res){
  if(!res.ok){ onFail({message:res.error}); return; }
  var h=head('점검','설정값 · FK 정합성');
  h+='<div class="bar"><button onclick="viewHc(true)">다시 점검</button>'+
     '<button onclick="runDriveCheck()">Drive 폴더 확인</button>'+
     '<span style="font-size:11.5px;color:var(--muted)">Drive 확인은 느려서 버튼을 눌렀을 때만 실행합니다</span></div>';
  h+='<div class="cards">'+card(res.summary.error,'오류',res.summary.error?'e':'g')+
     card(res.summary.warn,'경고',res.summary.warn?'w':'g')+'</div>';
  h+='<div class="panel" id="dvWrap"><h3>Drive 폴더</h3><div id="dvBox">'+
     '<div class="note">위 [Drive 폴더 확인] 버튼을 누르면 점검합니다</div></div></div>'+
     '<div style="height:14px"></div>';
  h+='<div class="panel"><h3>설정값</h3>'+table(['구분','설정키','내용'],res.config,function(r){
      return '<td class="lv '+esc(r.level)+'">'+esc(r.level)+'</td><td class="mono">'+esc(r.key)+'</td><td>'+esc(r.msg)+'</td>';
    })+'</div><div style="height:14px"></div>';
  h+='<div class="panel"><h3>정합성</h3>'+table(['구분','시트','ID','내용'],res.integrity,function(r){
      return '<td class="lv '+esc(r.level)+'">'+esc(r.level)+'</td><td>'+esc(r.sheet)+'</td>'+
             '<td class="mono">'+esc(r.id)+'</td><td>'+esc(r.msg)+'</td>';
    })+'</div>';
  el('view').innerHTML=h;
}
</script>
</body>
</html>
