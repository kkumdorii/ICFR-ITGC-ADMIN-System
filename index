  el('evBody').innerHTML='<div class="bar">'+opts('uC',f.control,'통제')+opts('uL',f.layer,'레이어')+
    opts('uD',f.dept,'수행부서')+
    '<button onclick="drawUndef()">조회</button><span class="cnt" id="uCnt"></span></div>'+
    '<div id="uT"></div><div class="note">이 목록이 0건이 되면 모든 평가단위에 증빙이 정의된 것입니다. '+
    '시트에 입력한 뒤 새로고침하면 반영됩니다.</div>';
  ['uC','uL','uD'].forEach(function(id){ el(id).onchange=drawUndef; });
  drawUndef();
}
function drawUndef(){
  var c=el('uC').value,l=el('uL').value,d=el('uD').value;
  var rows=DATA.evalUnits.filter(function(r){
    if(r.evCount) return false;
    if(c&&r.control!==c) return false;
    if(l&&r.layer!==l) return false;
    if(d&&r.dept!==d) return false;
    return true;
  });
  el('uCnt').textContent=rows.length+'건';
  el('uT').innerHTML=table(
    ['평가단위ID','통제','레이어','대상명','수행부서','표본','모집단정의'],
    rows,function(r){
      return '<td class="mono">'+esc(r.id)+'</td><td>'+esc(r.control)+'</td>'+
        '<td>'+layerTag(r.layer)+'</td><td>'+esc(r.target)+'</td><td>'+esc(r.dept)+'</td>'+
        '<td>'+esc(r.sampleType)+'</td><td>'+esc(String(r.population||'').substring(0,70))+'</td>';
    });
}

/* ── 담당자 요청메일 발송 ─────────────── */
var MLKIND='최초요청', MLDATA=null, MLHIST=null, MLSEL={};
function viewMl(force){
  el('view').innerHTML=head('담당자 요청메일 발송', DATA.meta.period+' 사이클')+
    '<div class="load"><span class="spin"></span>대상을 집계하는 중…</div>';
  google.script.run.withSuccessHandler(function(r){
    if(!r.ok){ onFail({message:r.error}); return; }
    MLDATA=r;
    google.script.run.withSuccessHandler(function(hh){
      MLHIST=hh.ok?hh:{scheduled:[],history:[]};
      drawMl();
    }).withFailureHandler(function(){ MLHIST={scheduled:[],history:[]}; drawMl(); }).getMailHistory();
  }).withFailureHandler(onFail).getMailTargets(MLKIND);
}
function mlKind(k){ MLKIND=k; MLSEL={}; viewMl(); }
function drawMl(){
  var d=MLDATA, t=d.targets;
  var h=head('담당자 요청메일 발송', d.period+' 사이클 · 제출 마감 '+esc(String(d.dueDate).substring(0,10)));

  if(String(d.mailEnabled).toUpperCase()!=='Y' || d.appMode==='테스트'){
    h+='<div class="warnbar"><b>실제 발송되지 않는 상태입니다.</b><br>'+
       'MAIL_ENABLED = '+esc(d.mailEnabled)+' · APP_MODE = '+esc(d.appMode)+'<br>'+
       (String(d.mailEnabled).toUpperCase()!=='Y'
         ? '메일은 나가지 않고 T_메일발송에 기록만 남습니다. '
         : '모든 메일이 '+esc(d.adminEmail)+' 로만 발송됩니다. ')+
       '실제 발송하시려면 C_설정에서 값을 바꾸십시오.</div>';
  }
  if(!d.webappUrl){
    h+='<div class="warnbar"><b>WEBAPP_URL 이 비어 있습니다.</b><br>'+
       'C_설정에 배포된 웹앱 주소를 넣으셔야 메일의 [증빙 제출하러 가기] 버튼이 동작합니다.</div>';
  }

  h+='<div class="tabs">'+
     '<a onclick="mlKind(\'최초요청\')" class="'+(MLKIND==='최초요청'?'on':'')+'">최초 요청</a>'+
     '<a onclick="mlKind(\'독촉\')" class="'+(MLKIND==='독촉'?'on':'')+'">독촉 (미제출자)</a>'+
     '<a onclick="viewAl()">정기 알람</a>'+
     '</div>';

  var able=t.filter(function(x){ return x.canSend; });
  h+='<div class="bar" style="margin-top:14px">'+
     '<button onclick="mlAll(true)">전체 선택</button>'+
     '<button onclick="mlAll(false)">선택 해제</button>'+
     '<button class="btn-p" onclick="mlSend()">선택 대상 즉시 발송</button>'+
     '<span style="font-size:12px;color:var(--mut);margin-left:8px">예약</span>'+
     '<input type="text" id="mlWhen" placeholder="2026-10-06 09:00" style="min-width:170px">'+
     '<button onclick="mlSchedule()">예약 발송</button>'+
     '<span class="cnt" id="mlCnt"></span></div>';

  h+='<div class="tw" style="max-height:none"><table><thead><tr>'+
     '<th class="mlsel"></th><th>담당자</th><th>부서</th><th>이메일</th>'+
     '<th>대상</th><th>제출</th><th>미제출</th><th>최근 발송</th><th>발송 횟수</th>'+
     '<th>미리보기</th><th>비고</th></tr></thead><tbody>';
  if(!t.length){
    h+='<tr><td colspan="11" style="text-align:center;color:var(--mut);padding:30px">'+
       (MLKIND==='독촉'?'미제출자가 없습니다.':'담당자가 지정된 증빙이 없습니다.')+'</td></tr>';
  }
  t.forEach(function(x){
    var dis=x.canSend?'':' disabled';
    h+='<tr><td class="mlsel"><input type="checkbox" class="mlck" value="'+esc(x.userId)+'"'+
       dis+(MLSEL[x.userId]?' checked':'')+' onchange="mlTick(this)"></td>'+
       '<td><b>'+esc(x.name)+'</b></td><td>'+esc(x.dept)+'</td>'+
       '<td class="mono">'+esc(x.email||'-')+'</td>'+
       '<td>'+x.total+'</td><td style="color:var(--ok)">'+x.done+'</td>'+
       '<td style="color:'+(x.todo?'var(--warn)':'var(--mut)')+';font-weight:bold">'+x.todo+'</td>'+
       '<td>'+esc(x.lastSent||'-')+'</td><td>'+x.sentCount+'</td>'+
       '<td><button onclick="mlPreview(\''+esc(x.userId)+'\')">본문 보기</button></td>'+
       '<td style="color:var(--warn)">'+esc(x.warn||'')+'</td></tr>';
