/* 평가대상기간 종료일 다음달 말일을 마감일로 제안한다 */
function pdDue(){
  var en=(el('pdEn').value||'').trim();
  var m=en.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if(!m) return;
  var y=+m[1], mo=+m[2]+1;
  if(mo>12){ mo=1; y++; }
  var last=new Date(y, mo, 0).getDate();
  var v=y+'-'+('0'+mo).slice(-2)+'-'+('0'+last).slice(-2);
  var d=el('pdDue2');
  if(d) d.textContent='제안 '+v;
  var box=el('pdDue');
  if(box && !box.dataset.touched) box.value=v;
}
function pdApply(){
  var p={period:el('pdSel').value, start:(el('pdSt').value||'').trim(),
         end:(el('pdEn').value||'').trim(), prev:el('pdPrev').value,
         due:(el('pdDue').value||'').trim()};
  var re=/^\d{4}-\d{2}-\d{2}$/;
  if(!re.test(p.start)||!re.test(p.end)){
    toast('평가대상기간을 확인하십시오','2026-07-01 형식으로 입력하십시오','wk'); return; }
  if(p.start>p.end){ toast('기간을 확인하십시오','시작일이 종료일보다 늦습니다','wk'); return; }
  if(!re.test(p.due)){ toast('마감일을 확인하십시오','2026-12-05 형식으로 입력하십시오','wk'); return; }
  if(p.prev===p.period){ toast('전기 기수를 확인하십시오','현재 기수와 같습니다','wk'); return; }

  var lbl=(DATA.filters.period||[]).filter(function(c){ return c.value===p.period; });
  var name=lbl.length?lbl[0].label:p.period;
  if(!confirm((DATA.meta.periodLabel||DATA.meta.period)+' → '+name+'\n'+
              p.start+' ~ '+p.end+' · 마감 '+p.due+'\n\n'+
              '모든 사용자 화면과 메일이 새 기수 기준으로 바뀝니다. 계속하시겠습니까?')) return;
  el('moB').innerHTML='<div class="load"><span class="spin"></span>전환하는 중…</div>';
  google.script.run.withSuccessHandler(function(r){
    if(!r.ok){ toast('전환 실패', r.error, 'er'); openPeriod(); return; }
    closeMo();
    toast(name+' 로 전환되었습니다', r.start+' ~ '+r.end+' · 마감 '+r.due, '');
    google.script.run.withSuccessHandler(function(res){
      if(res && res.ok){
        DATA=res; DATA.files=DATA.files||[];
        el('sideSub').innerHTML=esc(DATA.meta.periodLabel||DATA.meta.period);
        render();
      }
    }).getBootstrap();
  }).withFailureHandler(function(e){ toast('전환 실패', e.message, 'er'); openPeriod(); })
    .switchPeriod(p);
}

