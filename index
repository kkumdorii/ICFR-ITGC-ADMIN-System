function rdSave(chkId, target, autoItem){
  var item = autoItem || (el('rfItem')?el('rfItem').value.trim():'');
  if(!item){ toast('점검항목을 입력하십시오','','wk'); return; }
  var sum=(el('rfSum').value||'').trim();
  if(!sum){ toast('변동요약을 입력하십시오','변동이 없으면 변동없음 이라고 적으십시오','wk'); return; }
  var p={chkId:chkId, target:target, item:item,
         src:el('rfSrc').value, summary:sum,
         nNew:el('rfN').value, nMod:el('rfM').value, nDel:el('rfD').value,
         itgc:el('rfI').value, applied:el('rfA').value, done:el('rfC').value,
         euIds:(el('rfEu').value||'').trim(), ctrls:(el('rfCt').value||'').trim(),
         action:(el('rfAc').value||'').trim()};
  el('moB').innerHTML='<div class="load"><span class="spin"></span>저장하는 중…</div>';
  google.script.run.withSuccessHandler(function(r){
    if(!r.ok){ toast('저장 실패', r.error, 'er'); rdEdit(chkId); return; }
    closeMo();
    toast(r.updated?'기록이 수정되었습니다':'기록되었습니다', r.chkId, '');
    viewRd();
  }).withFailureHandler(function(e){ toast('저장 실패', e.message, 'er'); })
    .savePrecheckItem(p);
}
function rdConfirm(){
  var op=prompt('사전 점검을 확정합니다.\n\n총 '+RD.summary.total+'건 확인 · ITGC 영향 '+
    RD.summary.itgc+'건\n확정 의견을 입력하십시오.', '');
