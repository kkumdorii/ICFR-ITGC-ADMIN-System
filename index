      DT.viol, function(v){
      var ok=v.exc&&String(v.reason).trim();
      return '<td>'+esc(v.sysName)+'</td><td>'+esc(v.role)+'</td><td>'+esc(v.team)+'</td>'+
        '<td><b>'+esc(v.name)+'</b> '+esc(v.rank)+'</td><td>'+esc(v.part||'-')+'</td>'+
        '<td class="lv '+(ok?'WARN':'ERROR')+'">'+(ok?'예외 승인':'조치 필요')+'</td>'+
        '<td>'+esc(v.reason||'-')+'</td>'+
        '<td>'+(adm?(ok
          ? '<button onclick="dtRevoke(\''+esc(v.id)+'\')">예외 해제</button>'
          : '<button class="btn-p" onclick="dtApprove(\''+esc(v.id)+'\',\''+esc(v.name)+'\')">예외 승인</button>')
          :'')+'</td>';
