/* ── 운영평가 사전점검 ────────────────── */
var RD=null, RDSTEP='duty';
function viewRd(){
  el('view').innerHTML=head('운영평가 사전점검','증빙 요청 전 변동 확인')+
    '<div class="load"><span class="spin"></span>변동을 수집하는 중…</div>';
  google.script.run.withSuccessHandler(function(r){
    if(!r.ok){ onFail({message:r.error}); return; }
    RD=r;
    try{ GDCL = sessionStorage.getItem('itgc_gd')==='1'; }catch(e){}
    drawRd();
  }).withFailureHandler(onFail).getPrecheck();
}
function rdGo(k){ RDSTEP=k; drawRd(); window.scrollTo(0,0); }
function drawRd(){
  var r=RD, sm=r.summary;
  var h=head('운영평가 사전점검', esc(r.label)+' · '+esc(r.start)+' ~ '+esc(r.end))+lockBar();

  h+=rdGuide();

  /* 스텝바 */
  h+='<div class="steps">';
  r.steps.forEach(function(s,i){
    var cur=(s.key===RDSTEP);
    h+='<div class="stp '+s.state+(cur?' cur':'')+'" onclick="rdGo(\''+s.key+'\')">'+
       '<span class="sn">'+s.no+'</span>'+
       '<span class="sl"><b>'+esc(s.title)+'</b>'+
       '<span>'+esc(s.summary||'')+'</span></span></div>';
    if(i<r.steps.length-1) h+='<span class="sar">›</span>';
  });
  h+='</div>';

  var st=null;
  r.steps.forEach(function(s){ if(s.key===RDSTEP) st=s; });
  h+='<div id="rdBody">'+rdStepHtml(st)+'</div>';

  /* 하단 요약 */
  h+='<div style="height:20px"></div>'+
     '<div class="panel"><h3>이번 사이클 변동 요약</h3>'+
     '<div class="cards" style="margin-bottom:14px">'+
     card(sm.total,'전체 변동')+
     card(sm.byKind['신규']||0,'신규')+
     card(sm.byKind['폐기']||0,'폐기·전환')+
     card(sm.itgc,'ITGC 영향',sm.itgc?'w':'g')+
     card(sm.unlogged,'미기록',sm.unlogged?'e':'g')+
     card(sm.pending,'마스터 반영대기',sm.pending?'w':'g')+
     '</div>'+
     '<div class="grid">'+
     barPanel('구분별', Object.keys(sm.byTarget).map(function(k){
       return {label:k, count:sm.byTarget[k]}; }))+
     barPanel('변동유형별', Object.keys(sm.byKind).map(function(k){
       return {label:k, count:sm.byKind[k]}; }))+
     '</div>'+
     '<div class="bar" style="margin:16px 0 0">'+
     '<button class="btn-p" onclick="rdExport()">사전 점검 결과 다운로드</button>'+
     '<button onclick="viewRd()">다시 수집</button>'+
     '<span style="font-size:11.5px;color:var(--mut)">'+
     '요약 · 변동 상세 · 업무분장 · 변동점검 원장 4개 시트로 생성됩니다</span></div>'+
     '</div>';

  el('view').innerHTML=h;
}

var GDCL=false;
function rdGuide(){
  var g=RD.guide||[];
  if(!g.length) return '';
  var dn=g.filter(function(x){ return x.done; }).length;
  var tot=g.filter(function(x){ return !x.manual; }).length;
  var h='<div class="gd'+(GDCL?' cl':'')+'" id="gdBox">'+
    '<div class="gdh" onclick="gdTog()"><span class="ar">\u25BC</span>'+
    '<span>사이클 진행 순서</span>'+
    '<span class="cnt2">'+dn+' / '+tot+' 완료 · 반년에 한 번 하는 절차라 순서를 확인하고 진행하십시오</span>'+
    '</div><div class="gdb">';
  g.forEach(function(x){
    var cls = x.manual?'man':(x.done?'done':'');
    var sc  = x.manual?'m':(x.done?'y':'n');
    h+='<div class="gdr '+cls+'"><span class="n">'+x.no+'</span>'+
       '<span class="bd"><span class="t1">'+esc(x.title)+
       '<span class="wh">'+esc(x.where)+'</span></span>'+
       '<span class="d1">'+esc(x.desc)+'</span></span>'+
       '<span class="s1 '+sc+'">'+esc(x.stat)+'</span></div>';
  });
  h+='<div class="gdnote">';
  (RD.guideNote||[]).forEach(function(t){ h+='\u00B7 '+esc(t)+'<br>'; });
  h+='</div></div></div>';
  return h;
}
function gdTog(){
  GDCL=!GDCL;
  var e=el('gdBox');
  if(e) e.className='gd'+(GDCL?' cl':'');
  try{ sessionStorage.setItem('itgc_gd', GDCL?'1':''); }catch(err){}
}
function rdStepHtml(s){
  if(!s) return '';
  if(s.key==='duty') return rdDuty(s);
  if(s.key==='fin')  return rdFinal(s);
  return rdList(s);
}

function rdDuty(s){
  var d=s.duty||{};
  var c=d.counts||{total:0,viol:0,approved:0,unapproved:0};
  var h='<div class="panel"><h3>1. 업무분장 — 개발·운영 분리원칙</h3>';
  h+='<div class="cards" style="margin-bottom:12px">'+
     card(c.total,'담당자 행')+card(c.viol,'겸직',c.viol?'w':'g')+
     card(c.approved,'예외 승인')+card(c.unapproved,'조치 필요',c.unapproved?'e':'g')+'</div>';
  if(!d.reviewed){
    h+='<div class="warnbar"><b>이번 기수 검토 기록이 없습니다.</b><br>'+
