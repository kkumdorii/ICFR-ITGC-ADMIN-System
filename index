/* ── 업로드 · 붙여넣기 ────────────────── */
function doUp(i, defId, infra){
  if(guardBusy(i)) return;
  var inp=el('f'+i), msg=el('m'+i);
  if(!inp.files.length){ setMsg(i,'er','파일을 선택하십시오'); return; }
  var file=inp.files[0], mx=DATA.meta.maxMb||10;
  if(file.size > mx*1024*1024){ setMsg(i,'er',mx+'MB를 초과합니다'); return; }
  setBusy(true, i, '파일을 업로드하는 중입니다 ('+Math.round(file.size/1024)+'KB)');
  setMsg(i,'','');
  var fr=new FileReader();
  fr.onload=function(){
    var b64=fr.result.split(',')[1];
    google.script.run.withSuccessHandler(function(r){
      setBusy(false);
      if(r.ok){ PENDMSG={i:i, kind:'ok', title:'업로드 완료', sub:r.name};
                addFileLocal(defId, r); }
      else cardMsg(i,'er','업로드 실패', r.error);
    }).withFailureHandler(function(e){
      setBusy(false);
      cardMsg(i,'er','업로드 실패', e.message);
    }).uploadEvidence({defId:defId, fileName:file.name, mimeType:file.type, data:b64, infra:infra||''});
  };
  fr.readAsDataURL(file);
}
function rmUp(fileId){
  if(BUSY){ toast('잠시만 기다려 주십시오','저장이 진행 중입니다','wk'); return; }
  if(!confirm('이 파일을 삭제하시겠습니까?')) return;
  google.script.run.withSuccessHandler(function(r){
    if(r.ok) delFileLocal(fileId, '삭제 완료', '파일은 휴지통으로 이동합니다');
    else toast('삭제하지 못했습니다', r.error, 'er');
  }).withFailureHandler(onFail).removeEvidence(fileId);
}

var PVDATA={}, INFRA={}, ACTIVE_I=null, PASTE_BOUND=false, BUSY=false;

/* 저장은 한 번에 하나만. 중복 클릭을 막고 다른 카드도 잠근다 */
function setBusy(on, i, label){
  BUSY=on;
  var cards=document.querySelectorAll('.up[data-def]');
  for(var k=0;k<cards.length;k++){
    var ci=cards[k].getAttribute('data-i');
    var mine=(String(ci)===String(i));
    var st=cards[k].getAttribute('data-st')||'todo';
    cards[k].className='up '+st+(on&&mine?' saving':'')+
      (String(ci)===String(ACTIVE_I)?' act':'');
    if(on && mine){
      var ov=el('ov'+ci);
      if(ov) ov.innerHTML='<span class="spin"></span>'+(label||'저장 중입니다');
    }
    var bs=cards[k].querySelectorAll('button, input[type=file]');
    for(var j=0;j<bs.length;j++) bs[j].disabled = on && !mine;
  }
}
function guardBusy(i){
  if(!BUSY) return false;
  cardMsg(i,'wk','잠시만 기다려 주십시오','다른 항목을 저장하는 중입니다. 완료된 뒤 다시 시도하십시오.');
  return true;
}

/* 붙여넣기는 문서 전체에서 받고, 클릭으로 선택된 증빙 항목에 넣는다.
   포커스된 div에 paste 이벤트가 오지 않는 브라우저가 있어 이 방식을 쓴다 */
function bindPaste(){
  /* 구간별 붙여넣기 영역의 인프라ID를 기억해 둔다 */
  INFRA={};
  var ps=document.querySelectorAll('.paste[data-i]');
  for(var q=0;q<ps.length;q++){
    INFRA[ps[q].getAttribute('data-i')]=ps[q].getAttribute('data-infra')||'';
  }
  var cards=document.querySelectorAll('.up[data-def]');
  ACTIVE_I = ps.length===1 ? ps[0].getAttribute('data-i') : null;
  for(var k=0;k<cards.length;k++){
    cards[k].onclick=function(e){
      var tn=e.target && e.target.tagName;
      if(tn==='INPUT'||tn==='BUTTON'||tn==='A'||tn==='SELECT'||tn==='TEXTAREA') return;
      var seg=e.target.closest ? e.target.closest('.paste[data-i]') : null;
      setActive(seg ? seg.getAttribute('data-i') : this.getAttribute('data-i'));
    };
  }
  /* 구간 영역을 직접 클릭하면 그 구간이 대상이 된다 */
  for(var q2=0;q2<ps.length;q2++){
    ps[q2].onclick=function(e){ e.stopPropagation(); setActive(this.getAttribute('data-i')); };
  }
  markActive();
  if(PASTE_BOUND) return;
  PASTE_BOUND=true;
  document.addEventListener('paste', onDocPaste);
}
function setActive(i){ ACTIVE_I=i; markActive(); }
function markActive(){
  var cards=document.querySelectorAll('.up[data-def]');
  for(var k=0;k<cards.length;k++){
    var ci=cards[k].getAttribute('data-i');
    var on = String(ACTIVE_I)===String(ci) ||
             String(ACTIVE_I).indexOf(String(ci)+'_')===0;
    cards[k].className = cards[k].className.replace(/\s*act\b/,'') + (on?' act':'');
  }
  var ps=document.querySelectorAll('.paste[data-i]');
  for(var q=0;q<ps.length;q++){
    var pid=ps[q].getAttribute('data-i');
    ps[q].innerHTML = String(pid)===String(ACTIVE_I)
      ? '이 항목에 붙여넣습니다. 화면을 캡처(Win+Shift+S)하거나 조회 결과 표를 복사한 뒤 Ctrl+V 하십시오'
      : '이 영역을 클릭한 뒤 Ctrl+V 하십시오';
  }
}
function onDocPaste(e){
  if(V!=='up') return;
  if(DATA.meta.locked) return;
  var tg=e.target, tn=tg && tg.tagName;
  if(tn==='INPUT'||tn==='TEXTAREA'||tn==='SELECT'||(tg && tg.isContentEditable)) return;
  var cards=document.querySelectorAll('.up[data-def]');
  if(!cards.length) return;
  if(ACTIVE_I===null){
    toast('붙여넣을 항목을 먼저 선택하십시오','증빙 항목을 클릭한 뒤 Ctrl+V 하십시오','wk');
    return;
  }
  var i=ACTIVE_I, defId=null;
  var pe=el('p'+i);
  if(pe) defId=pe.getAttribute('data-def');
  if(!defId){
    for(var k=0;k<cards.length;k++){
      if(cards[k].getAttribute('data-i')===String(i)) defId=cards[k].getAttribute('data-def');
    }
  }
  if(!defId) return;
  e.preventDefault();
  if(guardBusy(i)) return;
  var cd=e.clipboardData||window.clipboardData, txt='';
  try{ txt=cd.getData('text/plain')||''; }catch(err){}
  if(txt && txt.trim()){ pasteTable(i, defId, txt); return; }
  var items=cd.items||[], img=null;
  for(var j=0;j<items.length;j++){
    if(items[j].type && items[j].type.indexOf('image')===0){ img=items[j].getAsFile(); break; }
  }
  if(img) pasteImage(i, defId, img);
  else setMsg(i,'er','붙여넣을 내용이 없습니다');
}
function pasteImage(i, defId, blob){
  var mx=DATA.meta.maxMb||10;
  if(blob.size > mx*1024*1024){ setMsg(i,'er',mx+'MB를 초과합니다'); return; }
  var fr=new FileReader();
  fr.onload=function(){
    PVDATA[i]={kind:'img', defId:defId, dataUrl:fr.result, size:blob.size, infra:INFRA[i]||''};
    el('pv'+i).innerHTML=
      '<div class="pvbar"><b>이미지 '+Math.round(blob.size/1024)+'KB</b> 인식'+
      '<button class="btn-p" onclick="savePv('+i+')">이 이미지로 저장</button>'+
      '<button onclick="clearPv('+i+')">취소</button>'+
      '<span style="color:#889">저장을 눌러야 업로드됩니다</span></div>'+
      '<img class="thumb" src="'+fr.result+'" onclick="openLb(this.src)">';
    setMsg(i,'','');
  };
  fr.readAsDataURL(blob);
}
function parseTsv(t){
  t=String(t).replace(/\r\n/g,'\n').replace(/\r/g,'\n');
  var rows=[], row=[], cur='', q=false;
  for(var i=0;i<t.length;i++){
    var c=t.charAt(i);
    if(q){
      if(c==='"'){ if(t.charAt(i+1)==='"'){ cur+='"'; i++; } else q=false; }
      else cur+=c;
    } else if(c==='"'){ q=true; }
    else if(c==='\t'){ row.push(cur); cur=''; }
    else if(c==='\n'){ row.push(cur); rows.push(row); row=[]; cur=''; }
    else cur+=c;
  }
  if(cur!=='' || row.length){ row.push(cur); rows.push(row); }
  return rows.filter(function(r){
    for(var j=0;j<r.length;j++){ if(String(r[j]).trim()!=='') return true; }
    return false;
  });
}
/**
 * 붙여넣은 텍스트를 표로 바꾼다.
 *   탭이 있으면 탭 구분, 없고 파이프가 일정하게 반복되면 파이프 구분
 *   ### 블록명 ### 이 있으면 구분 컬럼을 만들어 채운다
 *   ## 주석 ## 과 빈 줄은 버린다
 */
function parseSmart(text){
  var lines=String(text).replace(/\r\n/g,'\n').replace(/\r/g,'\n').split('\n');
  var secs=[], cur={name:'', lines:[]};
  lines.forEach(function(raw){
    var t=raw.trim();
    if(!t) return;
    var m=t.match(/^#{3,}\s*(.+?)\s*#{3,}$/);
    if(m){
      if(cur.lines.length) secs.push(cur);
      cur={name:m[1].trim(), lines:[]};
      return;
    }
    if(/^#{1,2}[^#]/.test(t)) return;          /* 주석 줄 */
    cur.lines.push(t);
  });
  if(cur.lines.length) secs.push(cur);
  if(!secs.length) return {rows:[], mode:''};

  /* 구분자 판정 */
  var all=[]; secs.forEach(function(x){ all=all.concat(x.lines); });
  var tabN=all.filter(function(l){ return l.indexOf('\t')>=0; }).length;
  var pipeCnt=all.map(function(l){ return (l.match(/\|/g)||[]).length; });
  var pipeN=pipeCnt.filter(function(n){ return n>0; }).length;
  var delim=null, mode='';
  if(tabN >= all.length*0.6){ delim='\t'; mode='탭'; }
  else if(pipeN >= all.length*0.6){
    /* 파이프 개수가 대체로 일정해야 표로 본다 */
    var only=pipeCnt.filter(function(n){ return n>0; });
    var mode1={}, top=0, topv=0;
    only.forEach(function(n){ mode1[n]=(mode1[n]||0)+1; if(mode1[n]>top){top=mode1[n];topv=n;} });
    if(top >= only.length*0.7){ delim='|'; mode='파이프'; }
  }
  if(!delim) return {rows: parseTsv(text), mode:'탭'};

  var split=function(l){
    return l.split(delim==='\t'?'\t':'|').map(function(c){ return c.trim(); });
  };
  var multi = secs.length>1 || (secs.length===1 && secs[0].name);

  /* 섹션별 헤더를 모아 공통 헤더를 만든다 */
  var heads=secs.map(function(x){ return split(x.lines[0]||''); });
  var cols=0; heads.forEach(function(hh){ if(hh.length>cols) cols=hh.length; });
  var head=[];
  for(var c=0;c<cols;c++){
    var u={}, arr=[];
    heads.forEach(function(hh){
      var v=(hh[c]||'').trim();
      if(v && !u[v]){ u[v]=1; arr.push(v); }
    });
    head.push(arr.join('/') || ('항목'+(c+1)));
  }
  var rows=[];
  rows.push(multi ? ['구분'].concat(head) : head);
  secs.forEach(function(x, si){
    x.lines.slice(1).forEach(function(l){
      var cells=split(l);
      while(cells.length<cols) cells.push('');
      rows.push(multi ? [x.name].concat(cells) : cells);
    });
  });
  return {rows: rows, mode: mode, sections: secs.length};
}

function pasteTable(i, defId, txt){
  var p=parseSmart(txt);
  var rows=p.rows;
  if(!rows.length){ setMsg(i,'er','표로 인식되지 않았습니다'); return; }
  PVDATA[i]={kind:'tbl', defId:defId, rows:rows, raw:txt, infra:INFRA[i]||''};
  var cols=rows[0].length;
  var h='<div class="pvbar"><b>'+rows.length+'행 × '+cols+'열</b> 인식'+
        (p.mode==='파이프'?' <span style="color:var(--brand);font-weight:bold">파이프 구분'+
          (p.sections>1?' · '+p.sections+'개 블록':'')+'</span>':'')+
        '<button class="btn-p" onclick="savePv('+i+')">이 내용으로 저장</button>'+
        '<button onclick="clearPv('+i+')">취소</button>'+
        '<span style="color:#889">엑셀 파일로 저장됩니다</span></div>';
  h+='<div class="pv"><table><thead><tr>';
  rows[0].forEach(function(c){ h+='<th>'+esc(c)+'</th>'; });
  h+='</tr></thead><tbody>';
  rows.slice(1,11).forEach(function(r){
    h+='<tr>'; for(var j=0;j<cols;j++){ h+='<td>'+esc(r[j]||'')+'</td>'; } h+='</tr>';
  });
  h+='</tbody></table></div>';
  if(rows.length>11) h+='<div class="note">상위 10행만 미리보기입니다. 저장 시 전체 '+(rows.length-1)+'행이 반영됩니다.</div>';
  h+='<div class="note">엑셀 파일은 시트 2개로 저장됩니다. [데이터]는 위 표, [원본]은 붙여넣으신 텍스트 그대로입니다.</div>';
  el('pv'+i).innerHTML=h;
  setMsg(i,'','');
}
function clearPv(i){ el('pv'+i).innerHTML=''; delete PVDATA[i]; setMsg(i,'','취소했습니다'); }
function savePv(i){
  var d=PVDATA[i];
  if(!d) return;
  if(guardBusy(i)) return;
  setBusy(true, i, d.kind==='img' ? '이미지를 저장하는 중입니다' : '엑셀 파일로 변환하는 중입니다');
  setMsg(i,'','');
  var ok=function(r){
    setBusy(false);
    if(r.ok){
      PENDMSG={i:i, kind:'ok', title:'저장 완료',
               sub:r.name + (r.rows ? ' · '+r.rows+'행 · '+(r.ext||'') : '')};
      delete PVDATA[i]; el('pv'+i).innerHTML='';
      addFileLocal(d.defId, r);
    } else cardMsg(i,'er','저장 실패', r.error);
  };
  var ng=function(e){
    setBusy(false);
    cardMsg(i,'er','저장 실패', e.message);
  };
  if(d.kind==='img'){
    google.script.run.withSuccessHandler(ok).withFailureHandler(ng)
      .uploadEvidence({defId:d.defId, fileName:'capture.png', mimeType:'image/png',
                       data:d.dataUrl.split(',')[1], infra:d.infra||''});
  } else {
    google.script.run.withSuccessHandler(ok).withFailureHandler(ng)
      .uploadTable({defId:d.defId, rows:d.rows, raw:d.raw||'', infra:d.infra||''});
  }
}

/* ── 증빙제출 ─────────────────────────── */
/* 서버를 부르지 않고 기동 시 받은 DATA로 계산한다. 담당자 전환이 즉시 반영된다 */
var UPUSER='';
function meUser(){
  var e=String(DATA.meta.user||'').toLowerCase();
  for(var i=0;i<DATA.users.length;i++){
    if(String(DATA.users[i].email||'').toLowerCase()===e) return DATA.users[i];
  }
  return null;
}
function userName(id){
  if(!id) return '';
  for(var i=0;i<DATA.users.length;i++){
    if(String(DATA.users[i].id)===String(id)) return DATA.users[i].name;
  }
  return String(id);          /* M_사용자에 없으면 ID·이메일 그대로 표시 */
}
function isAdminUser(){
  var m=meUser();
  return !!(m && (m.role==='관리자'||m.role==='검토자'));
}
/* 내 소속부서의 팀 계정 목록. 팀 앞으로 요청된 증빙은 팀원 누구나 처리한다 */
function myTeamIds(){
  var me=meUser(); if(!me) return [];
  return DATA.users.filter(function(u){
    return u.type==='팀' && u.status==='사용' && u.dept===me.dept;
  }).map(function(u){ return u.id; });
}
function isTeamAcct(uid){
  for(var i=0;i<DATA.users.length;i++)
    if(DATA.users[i].id===uid) return DATA.users[i].type==='팀';
  return false;
}
/* 참조 증빙의 원본 정보를 찾는다 */
function refSource(refId){
  for(var i=0;i<DATA.evidence.length;i++){
    if(String(DATA.evidence[i].id)===String(refId)) return DATA.evidence[i];
  }
  return null;
}
function euOf(euId){
  for(var i=0;i<DATA.evalUnits.length;i++){
    if(String(DATA.evalUnits[i].id)===String(euId)) return DATA.evalUnits[i];
  }
  return {};
}
function myItems(uid){
  var euMap={}; DATA.evalUnits.forEach(function(r){ euMap[r.id]=r; });
  var byDef={};
  DATA.files.forEach(function(f){ (byDef[f.defId]=byDef[f.defId]||[]).push(f); });
  /* 선택된 대상이 개인이면 본인 몫 + 소속부서 팀 몫을 함께 보여준다 */
  var keys={}; keys[String(uid)]=1;
  var me=meUser();
  if(me && String(me.id)===String(uid) && !isTeamAcct(uid)){
    myTeamIds().forEach(function(t){ keys[String(t)]=1; });
  }
  /* 참조 증빙은 담당자 목록에 따로 띄우지 않는다. 원본 카드에 "함께 사용" 표시만 한다 */
  var usedBy={};
  DATA.evidence.forEach(function(d){
    if(d.status!=='사용' || !d.refId) return;
    var eu=euMap[d.euId]||{};
    (usedBy[d.refId]=usedBy[d.refId]||[]).push({euId:d.euId, control:eu.control||'', defId:d.id});
  });
  return DATA.evidence
    .filter(function(d){ return d.status==='사용' && !d.refId && keys[String(d.ownerId)]; })
    .map(function(d){
      var eu=euMap[d.euId]||{};
      return {
        defId:d.id, euId:d.euId, seq:d.seq, type:d.type, desc:d.desc,
        required:d.required, ext:d.ext, method:d.method,
        control:eu.control||'', target:eu.target||'',
        exUrl:d.exUrl||'', exText:d.exText||'', exDesc:d.exDesc||'',
        rangeLabel:d.rangeLabel||'', rangeType:d.rangeType||'',
        rangeSplit:!!d.rangeSplit, rangeParts:d.rangeParts||[], hostNote:d.hostNote||'',
        ownerId:d.ownerId, team:isTeamAcct(d.ownerId), usedBy:usedBy[d.id]||[],
        files:(byDef[d.id]||[]).slice().sort(function(x,y){ return x.at<y.at?-1:1; })
      };
    })
    .sort(function(a,b){ return a.euId===b.euId ? (a.seq-b.seq) : (a.euId<b.euId?-1:1); });
}
var UPONLYTODO=true, UPOPEN={};
function myGroups(uid){
  var items=myItems(uid), g={}, order=[];
  items.forEach(function(it){
    if(!g[it.euId]){ g[it.euId]={euId:it.euId, control:it.control, target:it.target,
                                 team:it.team, items:[]};
                     order.push(it.euId); }
    if(it.team) g[it.euId].team=true;
    g[it.euId].items.push(it);
  });
  return order.map(function(k){
    var x=g[k];
    var real=x.items.filter(function(i){ return !i.refId; });
    x.done=real.filter(function(i){ return itemDone(i); }).length;
    x.total=real.length;
    x.refCnt=x.items.length-real.length;
    return x;
  });
}
