     table(['검토일시','기준일','기수','검토자','대상','겸직','예외','미승인','결론','검토의견'],
       (DTREV||[]).slice(0,50), function(r){
       return '<td>'+esc(r.at)+'</td><td>'+esc(r.base)+'</td><td>'+esc(r.period)+'</td>'+
         '<td>'+esc(r.by)+'</td><td>'+esc(r.total)+'</td><td>'+esc(r.viol)+'</td>'+
         '<td>'+esc(r.approved)+'</td><td>'+esc(r.unapproved)+'</td>'+
         '<td class="lv '+(r.concl==='적정'?'OK':'ERROR')+'">'+esc(r.concl)+'</td>'+
         '<td>'+esc(r.opinion||'-')+'</td>';
     })+'</div>';

  el('view').innerHTML=h;
}
/* 개발자 명단과 운영 역할 명단을 대조한 결과를 보여준다 */
function dtCheckCell(ck){
  if(!ck) return '<td class="chk">-</td>';
  var v=ck.verdict;
  var cls = v==='적정'?'ok':(v==='예외승인'?'ex':'ng');
  var ic  = v==='적정'?'\u2713':(v==='예외승인'?'\u26A0':'\u2715');
  var txt = v==='적정'?'분리됨':(v==='예외승인'?'예외 승인 '+ck.inter.length+'건':'조치 필요 '+ck.inter.length+'건');
  var h='<td class="chk"><div class="chkbox">'+
    '<div class="hd">개발자 '+ck.devs.length+'명</div>'+
    '<div class="nm">'+esc(ck.devs.join(' · ')||'-')+'</div>'+
    '<div class="hd">운영 역할 '+ck.ops.length+'명</div>'+
    '<div class="nm">'+esc(ck.ops.join(' · ')||'-')+'</div>'+
    '<div class="sep"></div>'+
    '<div class="vd '+cls+'"><span>'+ic+'</span>교집합 '+ck.inter.length+'명 · '+esc(txt)+'</div>';
  ck.inter.forEach(function(x){
    h+='<div class="nm" style="color:'+(x.exc?'#B8860B':'var(--err)')+';font-weight:bold">'+
       esc(x.name)+'</div>';
    if(x.exc && x.reason) h+='<div class="rs">'+esc(x.reason)+'</div>';
  });
  return h+'</div></td>';
}
