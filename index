/* 축하 폭죽. 외부 라이브러리 없이 캔버스로 직접 그린다 */
var CELEBRATED=null;
function celebrate(){
  if(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var old=el('cfti'); if(old) old.parentNode.removeChild(old);
  var cv=document.createElement('canvas');
  cv.id='cfti';
  cv.style.cssText='position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:1200';
  document.body.appendChild(cv);
  var dpr=window.devicePixelRatio||1;
  var W=cv.width=innerWidth*dpr, H=cv.height=innerHeight*dpr;
  var ctx=cv.getContext('2d');
  var cols=['#FF4D6D','#FF8FA3','#FFD23F','#FFB627','#4ECDC4','#3ABEFF',
            '#9B5DE5','#F15BB5','#00D98B','#FF7A45','#FFE066','#6C5CE7'];
  var P=[];
  function burst(ox, oy, n){
    for(var i=0;i<n;i++){
      var a=Math.random()*Math.PI*2, sp=(4+Math.random()*9)*dpr;
      P.push({x:ox, y:oy,
        vx:Math.cos(a)*sp, vy:Math.sin(a)*sp-6*dpr,
        w:(6+Math.random()*7)*dpr, h:(9+Math.random()*9)*dpr,
        c:cols[(Math.random()*cols.length)|0],
        r:Math.random()*Math.PI, vr:(Math.random()-.5)*.34,
        life:1, sq:Math.random()<.5, rib:Math.random()<.2});
    }
  }
  burst(W*0.20, H*0.46, 95);
  burst(W*0.80, H*0.46, 95);
  setTimeout(function(){ burst(W*0.5, H*0.30, 85); }, 240);
  setTimeout(function(){ burst(W*0.36, H*0.38, 55); burst(W*0.64, H*0.38, 55); }, 520);

  var t0=Date.now();
  (function loop(){
    var el2=el('cfti'); if(!el2) return;
    ctx.clearRect(0,0,W,H);
    var alive=0;
    for(var i=0;i<P.length;i++){
      var p=P[i];
      if(p.life<=0) continue;
      alive++;
      p.vy+=0.32*dpr; p.vx*=0.992; p.vy*=0.992;
      p.x+=p.vx; p.y+=p.vy; p.r+=p.vr;
      if(Date.now()-t0>1400) p.life-=0.016;
      if(p.y>H+60*dpr) p.life=0;
      ctx.save();
      ctx.globalAlpha=Math.max(p.life,0);
      ctx.translate(p.x,p.y); ctx.rotate(p.r);
      ctx.fillStyle=p.c;
      if(p.rib) ctx.fillRect(-p.w/5,-p.h*1.1,p.w*0.4,p.h*2.2);
      else if(p.sq) ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);
      else { ctx.beginPath(); ctx.ellipse(0,0,p.w/2,p.h/2,0,0,Math.PI*2); ctx.fill(); }
      ctx.restore();
    }
    if(alive>0 && Date.now()-t0<5000) requestAnimationFrame(loop);
    else if(el2.parentNode) el2.parentNode.removeChild(el2);
  })();
}

