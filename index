function itemDone(it){
  if(it.refId) return it.files.length>0;
  if(!it.rangeSplit || !it.rangeParts.length) return it.files.length>0;
  for(var i=0;i<it.rangeParts.length;i++){
    if(!partFiles(it, it.rangeParts[i].ids).length) return false;
  }
  return true;
}
function itemDoneCnt(it){
  if(!it.rangeSplit || !it.rangeParts.length) return it.files.length>0?1:0;
  var n=0;
  it.rangeParts.forEach(function(pt){ if(partFiles(it,pt.ids).length) n++; });
  return n;
