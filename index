  }

  /* 매트릭스 */
  h+='<div class="tw" style="max-height:none;margin-bottom:16px"><table class="mtx"><thead><tr>'+
     '<th style="left:0;z-index:3">대상시스템</th>';
  DT.roles.forEach(function(r){ h+='<th>'+esc(r)+'</th>'; });
  h+='<th>분리 검증</th></tr></thead><tbody>';
  DT.systems.forEach(function(s){
    h+='<tr><td class="sysn">'+esc(s.name)+'</td>';
    DT.roles.forEach(function(role){
